---
import Layout from "@/components/layouts/Layout.astro";
---

<Layout title="Volunteer">

  <!-- HERO -->
  <section class="volunteer-hero">
    <div class="volunteer-hero-image"></div>

    <div class="volunteer-hero-content">
      <h1>
        Make a difference.
        <span>Be a volunteer.</span>
      </h1>

      <div class="hero-line"></div>

      <p>
        Join our community of volunteers<br />
        and help us support people experiencing<br />
        vulnerability across Aotearoa.
      </p>
    </div>
  </section>


  <!-- WHERE WOULD YOU LIKE TO HELP? -->
  <section class="volunteer-programmes">

    <div class="section-heading">
      <h2>Where would you like to help?</h2>
      <div class="heading-line"></div>
    </div>

    <div class="programme-cards">

      <!-- TAKE 10 -->
      <article class="programme-card">

        <div class="card-icon">☕</div>

        <div class="card-content">
          <h3>Take 10</h3>

          <p>
            Help provide a safe zone on Courtenay Place.
          </p>

          <p>
            We’re looking for volunteers on Friday or Saturday
            nights from 10pm to 3am.
          </p>

          <a href="/take10/" class="learn-more">
            Learn more
          </a>
        </div>

      </article>


      <!-- TAKE 10 AUCKLAND -->
      <article class="programme-card">

        <div class="card-icon">☕</div>

        <div class="card-content">
          <h3>Take 10 Auckland</h3>

          <p>
            Help provide a safe zone on Auckland Central.
          </p>

          <p>
            We’re looking for volunteers on Friday or Saturday
            nights from 10pm to 3am.
          </p>

          <a href="/take10-auckland/" class="learn-more">
            Learn more
          </a>
        </div>

      </article>


      <!-- DO SOME GOOD -->
      <article class="programme-card">

        <div class="card-icon">♥</div>

        <div class="card-content">
          <h3>Do Some Good</h3>

          <p>
            Help influence positive change for tamariki living
            in hardship here in Wellington.
          </p>

          <p>
            We're looking for volunteers to come out with us
            to schools, and have a great day with tamariki in need.
          </p>

          <a href="/dosomegood/" class="learn-more">
            Learn more
          </a>
        </div>

      </article>

    </div>


    <!-- APPLY BUTTON -->
    <div class="apply-wrapper">
      <a href="#volunteer-form" class="apply-button">
        Apply to Volunteer
        <span>→</span>
      </a>

      <p>We’d love to hear from you!</p>
    </div>

  </section>


  <!-- VOLUNTEER FORM -->
  <section id="volunteer-form" class="volunteer-form-section">

    <div class="form-heading">
      <h2>Become a volunteer</h2>
      <p>We'd love to have you join our community.</p>
    </div>

    <form class="volunteer-form">

      <div class="form-group">
        <label for="name">Name</label>
        <input type="text" id="name" name="name" required />
      </div>

      <div class="form-group">
        <label for="email">Email</label>
        <input type="email" id="email" name="email" required />
      </div>

      <div class="form-group full-width">
        <label for="role">Role</label>

        <select id="role" name="role" required>
          <option value="">Select a role</option>
          <option value="take10">Take 10</option>
          <option value="take10-auckland">Take 10 Auckland</option>
          <option value="dosomegood">Do Some Good</option>
        </select>
      </div>

      <div class="form-group full-width">
        <label for="message">Message</label>

        <textarea
          id="message"
          name="message"
          rows="5"
          required
        ></textarea>
      </div>

      <button type="submit" class="submit-button">
        Submit application
      </button>

    </form>

  </section>

</Layout>


<style>

  /* HERO */

  .volunteer-hero {
    position: relative;
    min-height: 430px;
    display: flex;
    align-items: center;
    overflow: hidden;
    background: #111;
  }

  .volunteer-hero-image {
    position: absolute;
    inset: 0;

    background-image:
      linear-gradient(
        90deg,
        rgba(0,0,0,0) 35%,
        rgba(0,0,0,0.78) 68%,
        rgba(0,0,0,0.88) 100%
      ),
      url("/images/volunteer-hero.jpg");

    background-size: cover;
    background-position: center;
  }

  .volunteer-hero-content {
    position: relative;
    z-index: 2;
    width: 1200px;
    max-width: 90%;
    margin: 70px auto 0;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    text-align: left;
  }

  .volunteer-hero h1 {
    color: white;
    font-size: clamp(40px, 4vw, 58px);
    line-height: 1.05;
    margin: 0;
    font-weight: 700;
  }

  .volunteer-hero h1 span {
    display: block;
    color: #f58220;
    font-family: cursive;
    font-weight: 400;
    font-size: 0.95em;
    margin-top: 4px;
  }

  .hero-line {
    width: 80px;
    height: 4px;
    background: #f58220;
    margin: 22px 0;
    align-self: flex-start;
    margin-left: calc(50% + 100px);
  }

  .volunteer-hero p {
    color: white;
    font-size: 20px;
    line-height: 1.55;
    margin: 0;
    align-self: flex-start;
    margin-left: calc(50% + 100px);
  }


  /* PROGRAMMES */

  .volunteer-programmes {
    background: #fffaf5;
    padding: 55px 40px 70px;
  }

  .section-heading {
    text-align: center;
    margin-bottom: 35px;
  }

  .section-heading h2 {
    font-size: 38px;
    margin: 0;
    color: #171717;
  }

  .heading-line {
    width: 52px;
    height: 3px;
    background: #f58220;
    margin: 15px auto 0;
  }


  /* CARDS */

  .programme-cards {
    max-width: 1050px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 30px;
  }

  .programme-card {
    background: white;
    border: 1px solid #e8e2dc;
    border-radius: 14px;
    text-align: center;
    padding: 35px 25px 25px;
    transition: transform 0.2s ease;
  }

  .programme-card:hover {
    transform: translateY(-4px);
  }

  .card-icon {
    width: 58px;
    height: 58px;
    border-radius: 50%;
    background: #f58220;
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 25px;
    margin: 0 auto 18px;
  }

  .card-content h3 {
    font-size: 20px;
    margin: 0 0 15px;
    color: #171717;
  }

  .card-content p {
    color: #444;
    font-size: 15px;
    line-height: 1.5;
    margin: 0 0 12px;
  }

  .learn-more {
    display: inline-block;
    border: 1px solid #f58220;
    color: #f58220;
    padding: 9px 24px;
    border-radius: 7px;
    text-decoration: none;
    font-size: 14px;
    font-weight: 600;
    margin-top: 8px;
  }

  .learn-more:hover {
    background: #f58220;
    color: white;
  }


  /* APPLY */

  .apply-wrapper {
    text-align: center;
    margin-top: 30px;
  }

  .apply-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 35px;
    background: #f58220;
    color: white;
    text-decoration: none;
    font-weight: 700;
    font-size: 17px;
    padding: 13px 30px;
    border-radius: 30px;
    min-width: 255px;
  }

  .apply-button span {
    font-size: 25px;
  }

  .apply-wrapper p {
    margin-top: 10px;
    font-size: 14px;
    color: #333;
  }


  /* FORM */

  .volunteer-form-section {
    padding: 70px 30px;
    max-width: 900px;
    margin: 0 auto;
  }

  .form-heading {
    text-align: center;
    margin-bottom: 35px;
  }

  .form-heading h2 {
    font-size: 34px;
    margin-bottom: 8px;
  }

  .form-heading p {
    color: #555;
  }

  .volunteer-form {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 22px;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 7px;
  }

  .full-width {
    grid-column: 1 / -1;
  }

  .form-group label {
    font-weight: 600;
  }

  .form-group input,
  .form-group select,
  .form-group textarea {
    border: 1px solid #ddd;
    border-radius: 7px;
    padding: 12px;
    font-size: 16px;
    font-family: inherit;
  }

  .submit-button {
    grid-column: 1 / -1;
    justify-self: center;
    border: 0;
    background: #f58220;
    color: white;
    padding: 13px 35px;
    border-radius: 25px;
    font-size: 16px;
    font-weight: 700;
    cursor: pointer;
  }


  /* MOBILE */

  @media (max-width: 900px) {

    .programme-cards {
      grid-template-columns: 1fr;
      max-width: 400px;
    }

    .volunteer-hero-content {
      align-items: flex-start;
      margin-top: 40px;
    }

    .hero-line,
    .volunteer-hero p {
      margin-left: 0;
    }

  }

  @media (max-width: 600px) {

    .volunteer-hero {
      min-height: 500px;
    }

    .volunteer-hero-content {
      max-width: 85%;
    }

    .volunteer-hero h1 {
      font-size: 40px;
    }

    .volunteer-hero p {
      font-size: 17px;
    }

    .volunteer-programmes {
      padding-left: 20px;
      padding-right: 20px;
    }

    .volunteer-form {
      grid-template-columns: 1fr;
    }

    .full-width,
    .submit-button {
      grid-column: auto;
    }

  }

</style>