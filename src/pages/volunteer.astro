---
import { Image } from "astro:assets";

import Layout from "@/components/layouts/Layout.astro";
import Section from "@/components/layouts/section.astro";
import AnchorButton from "@/components/layouts/anchor-button.astro";

import Form from "@/components/Form.astro";
import { Label } from "@/components/ui/label";
import { Input } from "@/components/ui/input";
import { RoleSelect } from "@/components/pages/volunteer/RoleSelect";
import { Textarea } from "@/components/ui/textarea";

const title = "Volunteer";
---

<Layout title={title}>
  <!-- HERO -->
  <section class="volunteer-hero">
    <div class="volunteer-hero-content">
      <div class="volunteer-hero-text">
        <p class="volunteer-eyebrow">GET INVOLVED</p>

        <h1>Make a difference.</h1>

        <h2>Be a volunteer.</h2>

        <div class="orange-line"></div>

        <p class="volunteer-intro">
          Join our community of volunteers and help us support people
          experiencing vulnerability across Aotearoa.
        </p>
      </div>
    </div>
  </section>

  <!-- PROGRAMMES -->
  <Section>
    <div class="volunteer-programmes">

      <div class="volunteer-heading">
        <h2>Where would you like to help?</h2>
        <div class="orange-line"></div>
      </div>

      <div class="volunteer-cards">

        <!-- TAKE 10 -->
        <a href="/take10/" class="volunteer-card">
          <div class="volunteer-logo">
            <Image
              src={import("@/assets/img/logo/take10.png")}
              width={256}
              height={256}
              alt="Take 10 logo"
            />
          </div>

          <h3>Take 10</h3>

          <p>
            Help provide a safe zone on Courtenay Place.
          </p>

          <p>
            We’re looking for volunteers on Friday or Saturday nights from
            10pm to 3am.
          </p>

          <span class="learn-more">Learn more</span>
        </a>

        <!-- DO SOME GOOD -->
        <a href="/dosomegood/" class="volunteer-card">
          <div class="volunteer-logo dosomegood-logo">
            <Image
              src={import("@/assets/img/logo/dosomegood.png")}
              width={256}
              height={256}
              alt="Do Some Good logo"
            />
          </div>

          <h3>Do Some Good</h3>

          <p>
            Help influence positive change for tamariki living in hardship
            here in Wellington.
          </p>

          <p>
            We’re looking for volunteers to come out with us to schools,
            and have a great day with tamariki in need.
          </p>

          <span class="learn-more">Learn more</span>
        </a>

      </div>

      <!-- TAKE 10 AUCKLAND INFORMATION -->
      <div class="take10-auckland-note">
        <strong>Take 10</strong> also operates in Auckland Central.
        Volunteers are needed on Friday or Saturday nights from 10pm to 3am.
      </div>

      <!-- APPLY BUTTON -->
      <div class="apply-wrapper">
        <AnchorButton href="#volunteer-form" class="apply-button">
          Apply to Volunteer →
        </AnchorButton>

        <p>We’d love to hear from you!</p>
      </div>

    </div>
  </Section>

  <!-- FORM -->
  <Section>
    <div id="volunteer-form">
      <Form name="volunteer">

        <div>
          <Label htmlFor="name" className="required">Name</Label>

          <Input
            className="shadow-border"
            type="text"
            id="name"
            name="name"
            required
          />
        </div>

        <div>
          <Label htmlFor="email" className="required">Email</Label>

          <Input
            className="shadow-border"
            type="email"
            id="email"
            name="email"
            required
          />
        </div>

        <div class="sm:col-span-2">
          <Label htmlFor="role" className="required">Role</Label>

          <RoleSelect client:load />
        </div>

        <div class="sm:col-span-2">
          <Label htmlFor="message" className="required">Message</Label>

          <Textarea
            className="shadow-border"
            id="message"
            name="message"
            rows={4}
            required
          />
        </div>

      </Form>
    </div>
  </Section>
</Layout>

<style>
  /* ========================================
     HERO
     ======================================== */

  .volunteer-hero {
    background: #fffaf0;
    min-height: 500px;
    display: flex;
    align-items: center;
    position: relative;
    overflow: hidden;
  }

  .volunteer-hero::after {
    content: "";
    position: absolute;
    right: -120px;
    top: -180px;
    width: 520px;
    height: 520px;
    border-radius: 50%;
    background: #fff3c9;
    opacity: 0.55;
  }

  .volunteer-hero-content {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 90px 40px;
    position: relative;
    z-index: 1;
  }

  .volunteer-hero-text {
    max-width: 650px;
    margin-left: auto;
    margin-right: 40px;
  }

  .volunteer-eyebrow {
    color: #f47b20;
    font-weight: 700;
    letter-spacing: 2px;
    font-size: 15px;
    margin-bottom: 18px;
  }

  .volunteer-hero h1 {
    color: #171717;
    font-size: clamp(48px, 6vw, 76px);
    line-height: 1;
    font-weight: 800;
    margin: 0 0 8px;
    font-family:
      "Arial Rounded MT Bold",
      "Trebuchet MS",
      sans-serif;
  }

  .volunteer-hero h2 {
    color: #f47b20;
    font-size: clamp(38px, 5vw, 62px);
    line-height: 1;
    font-weight: 600;
    font-style: italic;
    margin: 0;
    font-family:
      "Arial Rounded MT Bold",
      "Trebuchet MS",
      sans-serif;
  }

  .orange-line {
    width: 70px;
    height: 4px;
    background: #f47b20;
    margin: 28px 0;
  }

  .volunteer-intro {
    color: #3f4650;
    font-size: 21px;
    line-height: 1.6;
    max-width: 590px;
    margin: 0;
  }


  /* ========================================
     PROGRAMMES
     ======================================== */

  .volunteer-programmes {
    padding: 35px 0 20px;
  }

  .volunteer-heading {
    text-align: center;
    margin-bottom: 42px;
  }

  .volunteer-heading h2 {
    color: #171717;
    font-size: clamp(34px, 4vw, 48px);
    line-height: 1.15;
    font-weight: 700;
    margin: 0;
    font-family:
      "Arial Rounded MT Bold",
      "Trebuchet MS",
      sans-serif;
  }

  .volunteer-heading .orange-line {
    margin: 18px auto 0;
  }


  /* ========================================
     CARDS
     ======================================== */

  .volunteer-cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 32px;
    max-width: 900px;
    margin: 0 auto;
  }

  .volunteer-card {
    min-height: 500px;
    padding: 42px 38px 36px;
    border: 1px solid #e8e1d8;
    border-radius: 24px;
    background: #ffffff;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.05);
    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease;
    text-decoration: none !important;
  }

  .volunteer-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 14px 32px rgba(0, 0, 0, 0.09);
    text-decoration: none !important;
  }

  .volunteer-card * {
    text-decoration: none !important;
  }

  .volunteer-logo {
    width: 150px;
    height: 150px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 20px;
  }

  .volunteer-logo img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .dosomegood-logo {
    width: 180px;
  }

  .volunteer-card h3 {
    color: #171717;
    font-size: 30px;
    font-weight: 700;
    margin: 5px 0 20px;
    font-family:
      "Arial Rounded MT Bold",
      "Trebuchet MS",
      sans-serif;
  }

  .volunteer-card p {
    color: #454545;
    font-size: 18px;
    line-height: 1.55;
    margin: 0 0 20px;
    max-width: 430px;
  }

  .learn-more {
    margin-top: auto;
    padding: 11px 28px;
    border: 2px solid #f47b20;
    border-radius: 8px;
    color: #f47b20;
    font-weight: 700;
    font-size: 16px;
    transition: all 0.2s ease;
  }

  .volunteer-card:hover .learn-more {
    background: #f47b20;
    color: white;
  }


  /* ========================================
     AUCKLAND NOTE
     ======================================== */

  .take10-auckland-note {
    max-width: 760px;
    margin: 28px auto 0;
    text-align: center;
    color: #454545;
    font-size: 17px;
    line-height: 1.5;
  }

  .take10-auckland-note strong {
    color: #171717;
  }


  /* ========================================
     APPLY
     ======================================== */

  .apply-wrapper {
    text-align: center;
    margin-top: 38px;
  }

  .apply-button {
    background: #f47b20 !important;
    font-size: 18px !important;
    padding: 15px 34px !important;
    border-radius: 30px !important;
  }

  .apply-wrapper p {
    margin-top: 12px;
    color: #454545;
    font-size: 16px;
  }


  /* ========================================
     HEADER - VOLUNTEER PAGE ONLY
     ======================================== */

  /*
   * Menu principal en noir
   * Les boutons ronds restent blancs
   */

  :global(body.volunteer-page nav a:not([class*="rounded-full"])) {
    color: #171717 !important;
    text-decoration: none !important;
  }

  :global(body.volunteer-page nav button) {
    color: #171717 !important;
  }

  :global(body.volunteer-page nav a:not([class*="rounded-full"]):hover) {
    color: #f47b20 !important;
    text-decoration: none !important;
  }

  :global(body.volunteer-page nav button:hover) {
    color: #f47b20 !important;
  }

  /*
   * Texte des boutons ronds :
   * TOUJOURS BLANC
   */

  :global(body.volunteer-page nav a[class*="rounded-full"]) {
    color: #ffffff !important;
    text-decoration: none !important;
  }

  :global(body.volunteer-page nav a[class*="rounded-full"]:hover) {
    color: #ffffff !important;
    text-decoration: none !important;
  }


  /* ========================================
     MOBILE
     ======================================== */

  @media (max-width: 768px) {
    .volunteer-hero {
      min-height: 450px;
    }

    .volunteer-hero-content {
      padding: 70px 25px;
    }

    .volunteer-hero-text {
      margin: 0;
    }

    .volunteer-intro {
      font-size: 18px;
    }

    .volunteer-cards {
      grid-template-columns: 1fr;
      max-width: 500px;
    }

    .volunteer-card {
      min-height: 460px;
    }
  }
</style>