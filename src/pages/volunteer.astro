---
import { Image } from "astro:assets";

import Layout from "@/components/layouts/Layout.astro";
import Section from "@/components/layouts/section.astro";
import AnchorButton from "@/components/layouts/anchor-button.astro";

import Banner from "@/components/Banner.astro";
import Form from "@/components/Form.astro";
import { Label } from "@/components/ui/label";
import { Input } from "@/components/ui/input";
import { RoleSelect } from "@/components/pages/volunteer/RoleSelect";
import { Textarea } from "@/components/ui/textarea";

const title = "Volunteer";
---

<Layout title={title}>
  <Banner title={title} programme="volunteer" />

  <Section>
    <Image
      src={import("@/assets/img/home/volunteer.png")}
      width="77"
      height="77"
      alt="volunteer image"
      fetchpriority="high"
      loading="eager"
      class="mx-auto"
      transition:name="volunteer"
    />
  </Section>

  <Section>
    <div class="mb-10 text-center">
      <h2 class="text-4xl font-normal">Where would you like to help?</h2>
      <div class="mx-auto mt-4 h-1 w-14 bg-orange-500"></div>
    </div>

    <div class="grid gap-8 md:grid-cols-3">

      <!-- Take 10 -->
      <a
        href="/take10/"
        class="group flex flex-col rounded-3xl border border-gray-200 bg-white p-8 text-center shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-lg"
      >
        <div class="mb-6 flex justify-center">
          <Image
            src={import("@/assets/img/logo/take10.png")}
            width="120"
            height="120"
            alt="Take 10 logo"
            class="size-28 object-contain"
          />
        </div>

        <h3 class="text-2xl font-semibold">Take 10</h3>

        <p class="mt-4">
          Help provide a safe zone on Courtenay Place.
        </p>

        <p class="mt-4">
          We’re looking for volunteers on Friday or Saturday nights from 10pm
          to 3am.
        </p>

        <span
          class="mx-auto mt-6 rounded-lg border border-orange-500 px-6 py-2 font-semibold text-orange-500 transition group-hover:bg-orange-500 group-hover:text-white"
        >
          Learn more
        </span>
      </a>

      <!-- Take 10 Auckland -->
      <a
        href="/take10-auckland/"
        class="group flex flex-col rounded-3xl border border-gray-200 bg-white p-8 text-center shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-lg"
      >
        <div class="mb-6 flex justify-center">
          <Image
            src={import("@/assets/img/logo/take10-auckland.png")}
            width="120"
            height="120"
            alt="Take 10 Auckland logo"
            class="size-28 object-contain"
          />
        </div>

        <h3 class="text-2xl font-semibold">Take 10 Auckland</h3>

        <p class="mt-4">
          Help provide a safe zone on Auckland Central.
        </p>

        <p class="mt-4">
          We’re looking for volunteers on Friday or Saturday nights from 10pm
          to 3am.
        </p>

        <span
          class="mx-auto mt-6 rounded-lg border border-orange-500 px-6 py-2 font-semibold text-orange-500 transition group-hover:bg-orange-500 group-hover:text-white"
        >
          Learn more
        </span>
      </a>

      <!-- Do Some Good -->
      <a
        href="/dosomegood/"
        class="group flex flex-col rounded-3xl border border-gray-200 bg-white p-8 text-center shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-lg"
      >
        <div class="mb-6 flex justify-center">
          <Image
            src={import("@/assets/img/logo/dosomegood.png")}
            width="120"
            height="120"
            alt="Do Some Good logo"
            class="size-28 object-contain"
          />
        </div>

        <h3 class="text-2xl font-semibold">Do Some Good</h3>

        <p class="mt-4">
          Help influence positive change for tamariki living in hardship here
          in Wellington.
        </p>

        <p class="mt-4">
          We’re looking for volunteers to come out with us to schools, and have
          a great day with tamariki in need.
        </p>

        <span
          class="mx-auto mt-6 rounded-lg border border-orange-500 px-6 py-2 font-semibold text-orange-500 transition group-hover:bg-orange-500 group-hover:text-white"
        >
          Learn more
        </span>
      </a>

    </div>

    <div class="mt-8 text-center">
      <AnchorButton href="/take10/volunteer.pdf" class="bg-orange-500 text-sm">
        Apply to Volunteer →
      </AnchorButton>

      <p class="mt-3">
        We’d love to hear from you!
      </p>
    </div>
  </Section>

  <Section>
    <Form name="volunteer">
      <div>
        <Label htmlFor="name" className="required">Name</Label>
        <Input
          className="shadow-border"
          type="text"
          id="name"
          name="name"
          required
        />
      </div>

      <div>
        <Label htmlFor="email" className="required">Email</Label>
        <Input
          className="shadow-border"
          type="email"
          id="email"
          name="email"
          required
        />
      </div>

      <div class="sm:col-span-2">
        <Label htmlFor="role" className="required">Role</Label>
        <RoleSelect client:load />
      </div>

      <div class="sm:col-span-2">
        <Label htmlFor="message" className="required">Message</Label>
        <Textarea
          className="shadow-border"
          id="message"
          name="message"
          rows={4}
          required
        />
      </div>
    </Form>
  </Section>
</Layout>