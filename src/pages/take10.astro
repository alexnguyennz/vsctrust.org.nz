---

<div class="take10-page">

  <!-- HERO -->
  <section class="hero">
    <div class="hero-image" style="background-image: url('/img/news/take10/take10-hero.jpg');">
      <div class="hero-overlay">
        <div class="hero-content">
          <p class="eyebrow">VULNERABLE SUPPORT CHARITABLE TRUST</p>
          <h1>Take 10</h1>
          <p class="hero-tagline">
            Creating a safe space to pause, rest and feel supported.
          </p>
        </div>
      </div>
    </div>
  </section>


  <!-- INTRODUCTION -->
  <section class="intro">
    <p class="section-label">TAKE 10</p>

    <h2>A safe space when you need it.</h2>

    <p class="intro-text">
      Take 10 provides a welcoming and supportive space for people
      who need a moment to pause, rest, reconnect and feel safe
      while out in the city.
    </p>
  </section>


  <!-- CHOOSE YOUR TAKE 10 -->
  <section class="locations">

    <div class="locations-heading">
      <p class="section-label">OUR LOCATIONS</p>
      <h2>Choose your <span class="take10-font">Take 10</span></h2>
    </div>


    <div class="location-grid">

      <!-- WELLINGTON -->
      <a href="/take10-wellington/" class="location-card">

        <div class="card-image wellington-image" style="background-image: url('/img/news/take10/take10-wellington.jpg');">
          <div class="card-overlay">
            <span>Explore</span>
          </div>
        </div>

        <div class="card-content">
          <p class="card-number">01</p>
          <h3><span class="take10-font">Take 10</span> Wellington</h3>

          <p>
            Discover Take 10 Wellington and the team
            creating safer nights in the city.
          </p>

          <span class="card-link">
            Explore Wellington →
          </span>
        </div>

      </a>


      <!-- AUCKLAND -->
      <a href="/take10-auckland/" class="location-card">

        <div class="card-image auckland-image" style="background-image: url('/img/news/take10/take10-auckland.jpg');">
          <div class="card-overlay">
            <span>Explore</span>
          </div>
        </div>

        <div class="card-content">
          <p class="card-number">02</p>
          <h3><span class="take10-font">Take 10</span> Auckland</h3>

          <p>
            Discover Take 10 Auckland and the team
            creating safer nights in Tāmaki Makaurau.
          </p>

          <span class="card-link">
            Explore Auckland →
          </span>
        </div>

      </a>

    </div>

  </section>

</div>


<style>

  @import url('https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&display=swap');

  .take10-page {
    background: #ffffff;
    color: #171717;
    font-family: Arial, sans-serif;
  }

  /* Police "logo" arrondie utilisée pour tous les "Take 10" */
  .take10-font,
  .hero h1 {
    font-family: 'Fredoka', Arial, sans-serif;
    font-weight: 700;
  }


  /* HERO */

  .hero {
    width: 100%;
  }

  .hero-image {
    min-height: 650px;
    background-size: cover;
    background-position: center;
    position: relative;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(0,0,0,0.65),
      rgba(0,0,0,0.05)
    );

    display: flex;
    align-items: flex-end;
  }

  .hero-content {
    color: white;
    padding: 70px;
    max-width: 850px;
  }

  .eyebrow,
  .section-label {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    margin-bottom: 18px;
  }

  .hero h1 {
    font-size: clamp(60px, 9vw, 120px);
    line-height: 0.9;
    margin: 0 0 25px;
    color: #ffffff;
  }

  .hero-tagline {
    font-size: clamp(18px, 1.6vw, 24px);
    line-height: 1.4;
    max-width: 650px;
    margin: 0;
    font-weight: 400;
  }


  /* INTRO */

  .intro {
    max-width: 900px;
    margin: 0 auto;
    padding: 120px 30px 100px;
    text-align: center;
  }

  .intro .section-label {
    color: #f15a24;
  }

  .intro h2 {
    font-size: clamp(30px, 3.5vw, 46px);
    line-height: 1.15;
    margin: 0 0 30px;
  }

  .intro-text {
    font-size: 20px;
    line-height: 1.7;
    color: #555;
    max-width: 720px;
    margin: 0 auto;
  }


  /* LOCATIONS */

  .locations {
    background: #f5f5f2;
    padding: 100px 5vw 120px;
  }

  .locations-heading {
    text-align: center;
    margin-bottom: 55px;
  }

  .locations-heading .section-label {
    color: #f15a24;
  }

  .locations-heading h2 {
    font-size: clamp(42px, 5vw, 70px);
    margin: 0;
  }

  .locations-heading .take10-font {
    color: inherit;
  }


  /* CARDS */

  .location-grid {
    max-width: 1250px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 30px;
  }

  .location-card {
    background: white;
    color: #171717;
    text-decoration: none;
    border-radius: 18px;
    overflow: hidden;
    display: block;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .location-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 20px 50px rgba(0,0,0,0.12);
  }


  /* CARD IMAGES */

  .card-image {
    height: 380px;
    background-size: cover;
    background-position: center;
    position: relative;
  }

  .card-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,0.15);
    opacity: 0;
    transition: opacity 0.3s ease;

    display: flex;
    align-items: center;
    justify-content: center;
  }

  .location-card:hover .card-overlay {
    opacity: 1;
  }

  .card-overlay span {
    background: white;
    padding: 12px 20px;
    border-radius: 50px;
    font-weight: 600;
  }


  /* CARD CONTENT */

  .card-content {
    padding: 35px;
  }

  .card-number {
    color: #f15a24;
    font-size: 13px;
    font-weight: 700;
    margin: 0 0 15px;
  }

  .card-content h3 {
    font-size: 34px;
    margin: 0 0 18px;
  }

  .card-content p:not(.card-number) {
    color: #666;
    line-height: 1.6;
    font-size: 16px;
    margin-bottom: 28px;
  }

  .card-link {
    font-weight: 700;
    font-size: 15px;
  }


  /* MOBILE */

  @media (max-width: 800px) {

    .hero-image {
      min-height: 550px;
    }

    .hero-content {
      padding: 35px 25px;
    }

    .intro {
      padding: 80px 25px;
    }

    .locations {
      padding: 75px 20px 90px;
    }

    .location-grid {
      grid-template-columns: 1fr;
    }

    .card-image {
      height: 300px;
    }

  }

</style>