---
import Layout from "@/components/layouts/Layout.astro";
---

<Layout title="Take 10">
<div class="take10-page">

  <!-- HERO -->
  <section class="hero">
    <div class="hero-image" style="background-image: url('/img/news/take10/take10-hero.jpg');">
      <div class="hero-overlay">
        <div class="hero-content">
          <span class="hero-badge">🌙 Every Friday &amp; Saturday night</span>
          <p class="eyebrow">VULNERABLE SUPPORT CHARITABLE TRUST</p>
          <h1>Take 10</h1>
          <p class="hero-tagline">
            Creating a safe space to pause, rest and feel supported.
          </p>
        </div>
      </div>
      <div class="hero-side-fade"></div>
    </div>
  </section>


  <!-- INTRODUCTION -->
  <section class="intro">
    <div class="intro-dot dot-1"></div>
    <div class="intro-dot dot-2"></div>
    <div class="intro-dot dot-3"></div>
    <div class="intro-dot dot-4"></div>
    <div class="intro-dot dot-5"></div>

    <p class="section-label">TAKE 10</p>

    <h2>A safe space when you need it.</h2>

    <div class="intro-divider"></div>

    <p class="intro-text">
      Take 10 provides a welcoming and supportive space for people
      who need a moment to pause, rest, reconnect and feel safe
      while out in the city.
    </p>
  </section>


  <!-- STATS -->
  <section class="stats">
    <div class="stats-inner">
      <div class="stats-grid">

        <div class="stat-item">
          <p class="stat-icon">🙌</p>
          <p class="stat-number">2,000+</p>
          <p class="stat-label">People supported every weekend</p>
        </div>

        <div class="stat-item">
          <p class="stat-icon">🌙</p>
          <p class="stat-number">Fri &amp; Sat</p>
          <p class="stat-label">10pm to 3am</p>
        </div>

        <div class="stat-item">
          <p class="stat-icon">📍</p>
          <p class="stat-number">2</p>
          <p class="stat-label">Cities: Wellington &amp; Auckland</p>
        </div>

        <div class="stat-item">
          <p class="stat-icon">💛</p>
          <p class="stat-number">100%</p>
          <p class="stat-label">Free, safe &amp; non-judgemental</p>
        </div>

      </div>
    </div>
  </section>


  <!-- CHOOSE YOUR TAKE 10 -->
  <section class="locations">

    <div class="locations-heading">
      <p class="section-label">OUR LOCATIONS</p>
      <h2>Choose your <span class="take10-font take10-orange">Take 10</span></h2>
    </div>


    <div class="location-grid">

      <!-- WELLINGTON -->
      <a href="/take10-wellington/" class="location-card">

        <div class="card-image wellington-image" style="background-image: url('/img/news/take10/take10-wellington.jpg');">
          <div class="card-overlay">
            <span>Explore</span>
          </div>
        </div>

        <div class="card-content">
          <p class="card-number">01</p>
          <h3><span class="take10-font take10-orange">Take 10</span> Wellington</h3>

          <p>
            Discover Take 10 Wellington and the team
            creating safer nights in the city.
          </p>

          <span class="card-link">
            Explore Wellington →
          </span>
        </div>

      </a>


      <!-- AUCKLAND -->
      <a href="/take10-auckland/" class="location-card">

        <div class="card-image auckland-image" style="background-image: url('/img/news/take10/take10-auckland.jpg');">
          <div class="card-overlay">
            <span>Explore</span>
          </div>
        </div>

        <div class="card-content">
          <p class="card-number">02</p>
          <h3><span class="take10-font take10-orange">Take 10</span> Auckland</h3>

          <p>
            Discover Take 10 Auckland and the team
            creating safer nights in Tāmaki Makaurau.
          </p>

          <span class="card-link">
            Explore Auckland →
          </span>
        </div>

      </a>

    </div>

  </section>

</div>
</Layout>


<style>

  @import url('https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&display=swap');

  .take10-page {
    background: #ffffff;
    color: #171717;
    font-family: Arial, sans-serif;
  }

  .take10-font,
  .hero h1 {
    font-family: 'Fredoka', Arial, sans-serif;
    font-weight: 700;
  }

  .take10-orange {
    color: #f15a24;
  }


  /* HERO */

  .hero {
    width: 100%;
    padding: 20px;
  }

  .hero-image {
    min-height: 650px;
    background-size: cover;
    background-position: center;
    position: relative;
    border-radius: 24px;
    overflow: hidden;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(20,10,0,0.75) 0%,
      rgba(241,90,36,0.08) 55%,
      rgba(0,0,0,0.05) 75%,
      rgba(0,0,0,0.35) 100%
    );

    display: flex;
    align-items: flex-end;
    z-index: 1;
  }

  .hero-side-fade {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to right,
      rgba(255,255,255,0.5) 0%,
      rgba(255,255,255,0.15) 18%,
      rgba(255,255,255,0) 35%
    );
    z-index: 1;
    pointer-events: none;
  }

  .hero-content {
    color: white;
    padding: 70px;
    max-width: 850px;
    position: relative;
    z-index: 2;
  }

  .eyebrow,
  .section-label {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    margin-bottom: 18px;
  }

  .hero-badge {
    display: inline-block;
    background: #f15a24;
    color: white;
    font-size: 14px;
    font-weight: 700;
    padding: 8px 18px;
    border-radius: 50px;
    margin-bottom: 22px;
  }

  .hero h1 {
    font-size: clamp(60px, 9vw, 120px);
    line-height: 0.9;
    margin: 0 0 25px;
    color: #ffffff;
  }

  .hero-tagline {
    font-size: clamp(18px, 1.6vw, 24px);
    line-height: 1.4;
    max-width: 650px;
    margin: 0;
    font-weight: 400;
  }


  /* INTRO */

  .intro {
    max-width: 900px;
    margin: 0 auto;
    padding: 70px 30px 50px;
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  .intro-dot {
    position: absolute;
    border-radius: 50%;
    background: #f15a24;
    z-index: 0;
    pointer-events: none;
  }

  .dot-1 {
    width: 14px;
    height: 14px;
    top: 30px;
    left: 8%;
    opacity: 0.18;
  }

  .dot-2 {
    width: 8px;
    height: 8px;
    top: 90px;
    left: 18%;
    opacity: 0.12;
  }

  .dot-3 {
    width: 18px;
    height: 18px;
    bottom: 40px;
    right: 10%;
    opacity: 0.15;
  }

  .dot-4 {
    width: 10px;
    height: 10px;
    top: 50px;
    right: 20%;
    opacity: 0.14;
  }

  .dot-5 {
    width: 6px;
    height: 6px;
    bottom: 90px;
    left: 22%;
    opacity: 0.16;
  }

  .intro .section-label,
  .intro h2,
  .intro-divider,
  .intro-text {
    position: relative;
    z-index: 1;
  }

  .intro h2 {
    font-size: clamp(30px, 3.5vw, 46px);
    line-height: 1.15;
    margin: 0;
  }

  .intro-divider {
    width: 60px;
    height: 4px;
    background: #f15a24;
    border-radius: 4px;
    margin: 26px auto 34px;
  }

  .intro-text {
    font-size: 20px;
    line-height: 1.7;
    color: #555;
    max-width: 720px;
    margin: 0 auto;
  }


  /* STATS */

  .stats {
    background: #fdf1ea;
    padding: 70px 5vw;
  }

  .stats-inner {
    max-width: 1100px;
    margin: 0 auto;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }

  .stat-item {
    text-align: center;
    padding: 0 15px;
    border-left: 1px solid rgba(241,90,36,0.2);
  }

  .stat-item:first-child {
    border-left: none;
  }

  .stat-icon {
    font-size: 28px;
    margin: 0 0 10px;
    line-height: 1;
  }

  .stat-number {
    font-family: 'Fredoka', Arial, sans-serif;
    font-weight: 700;
    font-size: clamp(28px, 3.2vw, 40px);
    color: #f15a24;
    margin: 0 0 8px;
    line-height: 1;
  }

  .stat-label {
    font-size: 14px;
    color: #666;
    margin: 0;
    line-height: 1.4;
  }


  /* LOCATIONS */

  .locations {
    background: #f5f5f2;
    padding: 100px 5vw 120px;
  }

  .locations-heading {
    text-align: center;
    margin-bottom: 55px;
  }

  .locations-heading .section-label {
    color: #f15a24;
  }

  .locations-heading h2 {
    font-size: clamp(42px, 5vw, 70px);
    margin: 0;
  }


  /* CARDS */

  .location-grid {
    max-width: 1250px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 30px;
  }

  .location-card {
    background: white;
    color: #171717;
    text-decoration: none;
    border-radius: 18px;
    overflow: hidden;
    display: block;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .location-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 20px 50px rgba(0,0,0,0.12);
  }


  /* CARD IMAGES */

  .card-image {
    height: 380px;
    background-size: cover;
    background-position: center;
    position: relative;
  }

  .card-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,0.15);
    opacity: 0;
    transition: opacity 0.3s ease;

    display: flex;
    align-items: center;
    justify-content: center;
  }

  .location-card:hover .card-overlay {
    opacity: 1;
  }

  .card-overlay span {
    background: white;
    padding: 12px 20px;
    border-radius: 50px;
    font-weight: 600;
  }


  /* CARD CONTENT */

  .card-content {
    padding: 35px;
  }

  .card-number {
    color: #f15a24;
    font-size: 13px;
    font-weight: 700;
    margin: 0 0 15px;
  }

  .card-content h3 {
    font-size: 34px;
    margin: 0 0 18px;
  }

  .card-content p:not(.card-number) {
    color: #666;
    line-height: 1.6;
    font-size: 16px;
    margin-bottom: 28px;
  }

  .card-link {
    font-weight: 700;
    font-size: 15px;
  }


  /* MOBILE */

  @media (max-width: 800px) {

    .hero {
      padding: 10px;
    }

    .hero-image {
      min-height: 550px;
      border-radius: 16px;
    }

    .hero-content {
      padding: 35px 25px;
    }

    .hero-side-fade {
      display: none;
    }

    .intro {
      padding: 60px 25px 30px;
    }

    .intro-dot {
      display: none;
    }

    .stats {
      padding: 50px 20px;
    }

    .stats-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 30px 15px;
    }

    .stat-item:first-child,
    .stat-item:nth-child(2) {
      border-top: none;
      padding-top: 0;
    }

    .stat-item {
      border-left: none;
      border-top: 1px solid rgba(241,90,36,0.2);
      padding-top: 25px;
    }

    .locations {
      padding: 75px 20px 90px;
    }

    .location-grid {
      grid-template-columns: 1fr;
    }

    .card-image {
      height: 300px;
    }

  }

</style>