---
import type { GetImageResult, ImageMetadata } from "astro";
import { getCollection, getEntry, render } from "astro:content";
import { Image, getImage } from "astro:assets";
import Layout from "@/components/layouts/Layout.astro";
import Section from "@/components/layouts/section.astro";
import FullSection from "@/components/layouts/full-section.astro";
import H2 from "@/components/headings/h2.astro";
import AnchorButton from "@/components/layouts/anchor-button.astro";
import poster from "@/assets/img/dosomegood/poster.png";
import Marquee from "@/components/ui/marquee";
import { Gallery } from "@/components/Gallery";
const sponsors = await getCollection("dosomegoodSponsors");
const supporters = await getCollection("dosomegoodSupporters");
const entry = await getEntry("pages", "dosomegood");
if (!entry) throw new Error("Could not find page");
const { Content } = await render(entry);
// Generate thumbnails
const images = await getCollection("dosomegoodImages");
const importedImages = import.meta.glob("../content/dosomegoodImages/*");
const thumbnails: { [key: string]: GetImageResult } = {};
for await (const image of images) {
  thumbnails[image.id] = await getImage({
    src: importedImages[
      `../content/dosomegoodImages/${image.id}.jpg`
    ]() as unknown as string,
    format: "webp",
    width: 500,
  });
}
---
<Layout title={entry.data.title}>

  <!-- SIMPLE PAGE HEADER -->
  <div class="bg-white pt-32 pb-10 text-center">
    <p class="text-orange-500 text-sm font-semibold uppercase tracking-wide mb-3">
      Our Programmes
    </p>
    <h1 class="text-4xl md:text-5xl font-bold text-gray-900">
      Do Some Good
    </h1>
    <div class="mx-auto mt-4 h-1 w-20 bg-orange-500"></div>
    <p class="mt-6 text-lg text-gray-600 max-w-2xl mx-auto px-5">
      Feeding tamariki. Supporting communities.
    </p>
  </div>

  <Section>
    <Gallery imageData={images} thumbnails={thumbnails} client:visible />
  </Section>

  <!-- WHAT DO WE DO -->
  <Section>
    <div class="grid gap-10 md:grid-cols-2 items-center">
      <img
        src={thumbnails["1"]?.src}
        alt="Do Some Good delivery"
        class="rounded-2xl w-full h-80 object-cover"
      />
      <div>
        <p class="text-orange-500 text-sm font-semibold uppercase tracking-wide mb-2">
          What do we do?
        </p>
        <p class="text-gray-700 leading-relaxed mb-4">
          We deliver fresh and tasty kai to kindergartens and primary schools across Wellington, Porirua, and Hutt Valley — fruit, veggies, dairy, bread, cold cuts, popcorn and other snacks.
        </p>
        <p class="text-gray-700 leading-relaxed">
          A well-fed child is better able to engage, focus and connect with those around them. Kai is also taken home by whānau to make meals through the week, acting as an equaliser so every tamariki has the chance to thrive.
        </p>
      </div>
    </div>
  </Section>

  <!-- HOW DO WE DO IT -->
  <Section>
    <div class="grid gap-10 md:grid-cols-2 items-center">
      <div class="md:order-2">
        <img
          src={thumbnails["4"]?.src}
          alt="Do Some Good volunteers"
          class="rounded-2xl w-full h-80 object-cover"
        />
      </div>
      <div class="md:order-1">
        <p class="text-orange-500 text-sm font-semibold uppercase tracking-wide mb-2">
          How do we do it?
        </p>
        <p class="text-gray-700 leading-relaxed mb-4">
          We work with corporate partners and donors to deliver our programme, giving the business community the chance to be part of a concerted effort to build well-connected communities.
        </p>
        <p class="text-gray-700 leading-relaxed">
          Our partners also volunteer their time at our schools — a real highlight for both teams and tamariki, who often get to muck in and help with the fun jobs on the day.
        </p>
      </div>
    </div>
  </Section>

  <!-- WE NEED YOUR HELP -->
  <Section class="text-center">
    <div class="max-w-2xl mx-auto">
      <p class="text-orange-500 text-sm font-semibold uppercase tracking-wide mb-2">
        We need your help!
      </p>
      <p class="text-gray-700 leading-relaxed mb-4">
        Our food support programme has felt the impact of the cost-of-living crisis, with less funding available and increased need in the community.
      </p>
      <p class="text-gray-700 leading-relaxed mb-4">
        If you are, or know of, a business or individual able to give back and make a difference for our tamariki and their whānau, please get in touch.
      </p>
      <p class="text-gray-700 leading-relaxed">
        You can reach our Operations Manager, Leigh Keown, at
        <a href="mailto:hello@vsctrust.org.nz" class="underline hover:text-orange-500">hello@vsctrust.org.nz</a>.
      </p>
    </div>
  </Section>

  <Section>
    <video
      poster={poster.src}
      preload="none"
      controls
      muted
      class="mx-auto w-full max-w-2xl rounded-3xl shadow-lg"
    >
      <source src="/dosomegood/video.webm" type="video/webm" />
      <source src="/dosomegood/video.mp4" type="video/mp4" />
      Your browser does not support the video tag.
    </video>
  </Section>
  <Section class="text-center">
    <H2>Want to help?</H2>
    <div class="grid gap-6 lg:grid-cols-2 lg:gap-12">
      <div class="flex flex-col">
        <p>
          {entry.data.sponsorASchoolDescription}
        </p>
        <div class="mx-auto mt-auto">
          <AnchorButton
            href="/sponsor-a-school/"
            class="bg-red-600"
            rel="prefetch">Sponsor a school</AnchorButton
          >
        </div>
      </div>
      <div class="flex flex-col">
        <p>
          {entry.data.volunteerDescription}
        </p>
        <div class="mx-auto mt-auto">
          <AnchorButton href="/volunteer/" class="bg-red-600" rel="prefetch"
            >Volunteer</AnchorButton
          >
        </div>
      </div>
    </div>
  </Section>
  <FullSection>
    <H2>Sponsors</H2>
    <Marquee
      pauseOnHover
      className="gap-10 [--duration:55s] [--gap:4rem]"
      client:visible
    >
      {
        sponsors.map(({ data: sponsor }) =>
          sponsor.website ? (
            <a href={sponsor.website} target="_blank" rel="noopener nofollow noreferrer">
              <Image
                src={sponsor.image as ImageMetadata}
                height="64"
                alt={sponsor.name!}
                loading="eager"
                class="mx-auto"
              />
            </a>
          ) : (
            <div>
              <Image
                src={sponsor.image as ImageMetadata}
                height="64"
                alt={sponsor.name!}
                loading="eager"
                class="mx-auto"
              />
            </div>
          ),
        )
      }
    </Marquee>
  </FullSection>
  <FullSection>
    <H2>Supporters</H2>
    <Marquee
      reverse
      pauseOnHover
      className="gap-10 [--duration:50s] [--gap:4rem]"
      client:visible
    >
      {
        supporters.map(({ data }) =>
          data.website ? (
            <a href={data.website} target="_blank" rel="noopener nofollow noreferrer">
              <Image
                src={data.image as ImageMetadata}
                height="64"
                alt={data.name!}
                loading="eager"
                class="mx-auto"
              />
            </a>
          ) : (
            <div>
              <Image
                src={data.image as ImageMetadata}
                height="64"
                alt={data.name!}
                loading="eager"
                class="mx-auto"
              />
            </div>
          ),
        )
      }
    </Marquee>
  </FullSection>
</Layout>