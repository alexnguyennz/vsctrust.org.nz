---
import { getCollection, getEntry, render } from "astro:content";
import type { GetImageResult, ImageMetadata } from "astro";
import { Image, getImage } from "astro:assets";

import Layout from "@/components/layouts/Layout.astro";
import Section from "@/components/layouts/section.astro";
import FullSection from "@/components/layouts/full-section.astro";
import H2 from "@/components/headings/h2.astro";
import AnchorButton from "@/components/layouts/anchor-button.astro";

import poster from "@/assets/img/take10/poster.png";
import Marquee from "@/components/ui/marquee";
import { Gallery } from "@/components/Gallery";

const sponsors = await getCollection("take10Sponsors");

const entry = await getEntry("pages", "take10");
if (!entry) throw new Error("Could not find page");

const { Content } = await render(entry);

// Generate thumbnails
const images = await getCollection("take10Images");
const importedImages = import.meta.glob("../content/take10Images/*");

const thumbnails: { [key: string]: GetImageResult } = {};

for await (const image of images) {
  thumbnails[image.id] = await getImage({
    src: importedImages[
      `../content/take10Images/${image.id}.jpg`
    ]() as unknown as string,
    format: "webp",
    width: 500,
  });
}
---

<Layout title={entry.data.title}>

  <!-- =====================================================
       HERO
       ===================================================== -->

  <section class="relative w-full overflow-hidden bg-white pt-28 sm:pt-32 lg:pt-36">

    <div class="relative mx-auto max-w-7xl px-6 lg:px-10">

      <div class="relative min-h-[480px] overflow-hidden rounded-[28px] sm:min-h-[420px]">

        {
          images[0] && (
            <img
              src={thumbnails[images[0].id].src}
              alt={entry.data.title}
              class="absolute inset-0 h-full w-full object-cover"
            />
          )
        }

        <!-- WHITE FADE (left + bottom) -->
        <div class="absolute inset-0 bg-gradient-to-r from-white via-white/40 to-transparent"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-white/20 via-transparent to-transparent"></div>

        <!-- DARK VIGNETTE BEHIND PARAGRAPH TEXT -->
        <div class="absolute inset-x-0 bottom-0 h-2/3 bg-gradient-to-t from-black/55 via-black/15 to-transparent"></div>

        <!-- HANDWRITTEN NOTE -->
        <div class="take10-script pointer-events-none absolute right-10 top-6 text-right leading-snug text-white sm:right-14 sm:top-8">
          <p class="text-lg sm:text-xl">People Support</p>
          <p class="text-lg sm:text-xl">Safer Nights</p>
          <p class="relative inline-block text-lg sm:text-xl">
            Stronger Communities
            <span class="absolute -bottom-1 left-0 h-px w-full bg-white/80"></span>
          </p>
        </div>

        <!-- DOODLE -->
        <svg viewBox="0 0 40 24" class="absolute left-[38%] top-6 h-6 w-8 shrink-0 sm:top-8" stroke="#f97316" stroke-width="3" stroke-linecap="round" fill="none">
          <line x1="4" y1="20" x2="10" y2="6" />
          <line x1="16" y1="20" x2="22" y2="6" />
        </svg>

        <!-- TEXT CONTENT -->
        <div class="relative z-10 flex min-h-[480px] items-center px-6 py-10 sm:min-h-[420px] sm:px-10 lg:px-14">

          <div class="max-w-lg">

            <div class="mb-4 flex items-center gap-4">
              <span
                class="text-sm font-bold uppercase tracking-[0.18em] text-orange-500"
              >
                Take 10
              </span>
              <span class="h-px w-12 bg-orange-500"></span>
            </div>

            <h1
              class="text-4xl font-bold leading-[1.05] tracking-tight text-gray-950 sm:text-5xl"
            >
              {entry.data.title}
            </h1>

            <div class="mt-5 max-w-md rounded-2xl bg-black/55 p-4 backdrop-blur-sm">
              <p class="text-lg font-medium leading-relaxed text-white">
                Creating safer nights, one connection at a time.
              </p>

              <p class="mt-3 text-white/90">
                Take 10 runs on Friday and Saturday nights on the corner of
                Courtenay Place and Taranaki Street, offering a safe and
                welcoming space for anyone who needs a break, a chat, or a
                little support.
              </p>
            </div>

            <div class="mt-8">
              <a
                href="/take10/"
                rel="prefetch"
                class="inline-flex items-center gap-2 rounded-full bg-orange-500 px-7 py-3.5 text-base font-semibold text-white transition hover:bg-orange-600"
              >
                Learn more about Take 10 →
              </a>
            </div>

          </div>

        </div>

      </div>

    </div>

    <style>
      @import url('https://fonts.googleapis.com/css2?family=Dancing+Script:wght@500&display=swap');

      .take10-script {
        font-family: 'Dancing Script', cursive;
      }
    </style>


    <!-- INFO PILL -->
    <div class="mx-auto mt-8 max-w-7xl px-6 pb-14 lg:px-10 lg:pb-16">

      <div
        class="grid divide-y divide-orange-100 rounded-3xl bg-orange-50/60 sm:grid-cols-3 sm:divide-x sm:divide-y-0"
      >

        <div class="flex items-center gap-4 p-6">
          <div class="flex size-11 shrink-0 items-center justify-center rounded-full bg-orange-100">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-5 text-orange-500">
              <rect x="3" y="4" width="18" height="18" rx="2" />
              <line x1="16" y1="2" x2="16" y2="6" />
              <line x1="8" y1="2" x2="8" y2="6" />
              <line x1="3" y1="10" x2="21" y2="10" />
            </svg>
          </div>
          <div>
            <p class="text-xs font-bold uppercase tracking-wide text-gray-500">
              When?
            </p>
            <p class="font-semibold text-gray-900">Friday &amp; Saturday</p>
            <p class="text-sm text-gray-500">nights</p>
          </div>
        </div>

        <div class="flex items-center gap-4 p-6">
          <div class="flex size-11 shrink-0 items-center justify-center rounded-full bg-orange-100">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-5 text-orange-500">
              <circle cx="12" cy="12" r="10" />
              <polyline points="12 6 12 12 16 14" />
            </svg>
          </div>
          <div>
            <p class="text-xs font-bold uppercase tracking-wide text-gray-500">
              Time
            </p>
            <p class="font-semibold text-gray-900">10PM – 3AM</p>
          </div>
        </div>

        <div class="flex items-center gap-4 p-6">
          <div class="flex size-11 shrink-0 items-center justify-center rounded-full bg-orange-100">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-5 text-orange-500">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
              <circle cx="12" cy="10" r="3" />
            </svg>
          </div>
          <div>
            <p class="text-xs font-bold uppercase tracking-wide text-gray-500">
              Where?
            </p>
            <p class="font-semibold text-gray-900">Wellington</p>
            <p class="text-sm text-gray-500">Courtenay Place &amp; Taranaki St</p>
          </div>
        </div>

      </div>

    </div>

  </section>


  <!-- =====================================================
       ABOUT / MAIN CONTENT
       ===================================================== -->

  <Section>

    <div class="grid gap-10 lg:grid-cols-[1fr_320px] lg:items-start lg:gap-14">

      <div
        class="max-w-2xl space-y-4 text-lg leading-relaxed text-gray-700 [&_h2]:mb-4 [&_h2]:mt-10 [&_h2]:text-2xl [&_h2]:font-bold [&_h2]:leading-tight [&_h2]:text-gray-950 [&_li]:mb-2 [&_strong]:text-gray-900 [&_ul]:mt-2 [&_ul]:list-disc [&_ul]:space-y-2 [&_ul]:pl-5"
      >
        <Content />
      </div>

      <div class="flex flex-row gap-4 lg:sticky lg:top-28 lg:flex-col">

        {
          images[1] && (
            <img
              src={thumbnails[images[1].id].src}
              alt={entry.data.title}
              class="h-40 w-1/2 rounded-2xl object-cover shadow-lg lg:h-48 lg:w-full"
            />
          )
        }

        {
          images[2] && (
            <img
              src={thumbnails[images[2].id].src}
              alt={entry.data.title}
              class="h-40 w-1/2 rounded-2xl object-cover shadow-lg lg:h-48 lg:w-full"
            />
          )
        }

      </div>

    </div>

  </Section>


  <!-- =====================================================
       A LOOK AT TAKE 10 WELLINGTON
       ===================================================== -->

  <Section>

    <div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="mb-2 text-sm font-bold uppercase tracking-wide text-orange-500">
          A look at
        </p>
        <H2>{entry.data.title}</H2>
      </div>

      <p class="relative max-w-md text-gray-600">
        From handing out water and snacks to having meaningful conversations,
        our volunteers are out in Wellington's night-time economy,
        supporting people and making a real difference.
        <svg viewBox="0 0 40 24" class="absolute -right-10 top-0 h-6 w-8 shrink-0 sm:-right-12" stroke="#f97316" stroke-width="3" stroke-linecap="round" fill="none">
          <line x1="4" y1="20" x2="10" y2="6" />
          <line x1="16" y1="20" x2="22" y2="6" />
        </svg>
      </p>
    </div>

    <Gallery imageData={images} thumbnails={thumbnails} client:visible />

  </Section>


  <Section>
    <video
      poster={poster.src}
      preload="none"
      controls
      muted
      class="mx-auto w-full max-w-2xl rounded-3xl shadow-lg"
    >
      <source src="/take10/video.webm" type="video/webm" />
      <source src="/take10/video.mp4" type="video/mp4" />
      Your browser does not support the video tag.
    </video>
  </Section>

  <Section>
    <H2>How it works</H2>

    <div class="grid gap-10 sm:grid-cols-2">
      <div>
        <p>We aim to:</p>
        <ul>
          <li>prevent harm</li>
          <li>offer a safe & trusted space</li>
          <li>provide friendly & welcoming support</li>
        </ul>
      </div>

      <div>
        <p>We keep our "safe zone" welcoming and non-judgmental by:</p>
        <ul>
          <li>always using positive language</li>
          <li>greeting visitors with a smile, water, and lollies</li>
          <li>providing a private space for those who need more attention</li>
        </ul>
      </div>
    </div>
  </Section>


  <!-- =====================================================
       GET INVOLVED / BE PART OF TAKE 10
       ===================================================== -->

  <Section>

    <div
      class="mx-auto flex max-w-5xl flex-col items-center gap-6 rounded-3xl bg-orange-50 p-8 text-center sm:flex-row sm:text-left lg:p-12"
    >

      <div class="flex size-16 shrink-0 items-center justify-center rounded-full bg-white shadow">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-8 text-orange-500">
          <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
          <circle cx="9" cy="7" r="4" />
          <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
          <path d="M16 3.13a4 4 0 0 1 0 7.75" />
        </svg>
      </div>

      <div class="flex-1">

        <p class="mb-1 text-sm font-bold uppercase tracking-wide text-orange-500">
          Get Involved
        </p>

        <h2 class="text-2xl font-bold text-gray-950 sm:text-3xl">
          Be part of Take 10
        </h2>

        <div class="mt-3 space-y-2 text-gray-700">
          {
            entry.data.wantToHelpDescription.map((description: string) => (
              <p>{description}</p>
            ))
          }
        </div>

      </div>

      <AnchorButton href="/volunteer/" class="bg-orange-500" rel="prefetch">
        Become a Volunteer
      </AnchorButton>

    </div>

  </Section>


  <FullSection>
    <H2>Sponsors</H2>

    <Marquee
      pauseOnHover
      className="gap-10 [--duration:90s] [--gap:4rem]"
      client:visible
    >
      {
        sponsors.map(({ data: sponsor }) =>
          sponsor.website ? (
            <a
              href={sponsor.website}
              target="_blank"
              rel="noopener nofollow noreferrer"
            >
              <Image
                src={sponsor.image as ImageMetadata}
                height="64"
                alt={sponsor.name!}
                loading="eager"
                class="mx-auto"
              />
            </a>
          ) : (
            <div>
              <Image
                src={sponsor.image as ImageMetadata}
                height="64"
                alt={sponsor.name!}
                loading="eager"
                class="mx-auto"
              />
            </div>
          ),
        )
      }
    </Marquee>
  </FullSection>

</Layout>