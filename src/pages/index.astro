  <!-- HERO -->
  <section class="relative h-screen min-h-[720px] w-full overflow-hidden bg-white">

    <!-- HERO IMAGE -->
    <Picture
      src={import("@/assets/img/banner/home/home.png")}
      width={2200}
      height={300}
      formats={["avif", "webp"]}
      alt="Home banner"
      class="absolute inset-0 h-full w-full object-cover"
      priority={true}
      fetchpriority="high"
    />

    <!-- DARK OVERLAY -->
    <div class="absolute inset-0 bg-black/15"></div>

    <!-- SOFT WHITE EDGES -->
    <div
      class="absolute inset-0 pointer-events-none"
      style="
        background:
          radial-gradient(
            ellipse at center,
            transparent 48%,
            rgba(255,255,255,0.08) 65%,
            rgba(255,255,255,0.55) 88%,
            white 100%
          );
      "
    ></div>

    <!-- TOP SOFT WHITE -->
    <div
      class="absolute inset-x-0 top-0 h-36 pointer-events-none"
      style="
        background: linear-gradient(
          to bottom,
          rgba(255,255,255,0.95),
          rgba(255,255,255,0.55),
          transparent
        );
      "
    ></div>


    <!-- HERO CONTENT -->
    <div class="absolute inset-0 z-10">

      <div class="mx-auto h-full max-w-7xl px-8 lg:px-12">

        <!-- MAIN LEFT CONTENT -->
        <div class="flex h-full items-center">

          <div class="max-w-[650px] pt-16">

            <!-- EYEBROW -->
            <div class="mb-5 flex items-center gap-3">

              <span class="h-px w-12 bg-white"></span>

              <span
                class="text-xs font-medium uppercase tracking-[0.25em] text-white"
              >
                People · Communities · Brighter tomorrows
              </span>

            </div>


            <!-- MAIN TITLE -->
            <h1
              class="text-5xl font-bold leading-[1.02] tracking-tight text-white drop-shadow-lg md:text-6xl lg:text-7xl"
            >
              Supporting people,
              <br />
              strengthening
              <br />
              communities
            </h1>


            <!-- SUBTITLE -->
            <p
              class="mt-6 text-xl font-medium text-white drop-shadow-md md:text-2xl"
            >
              Working together for a better tomorrow
            </p>


            <!-- PROGRAMME LOGOS -->
            <div class="mt-7 flex items-center gap-5">

              <a
                href="/take10/"
                class="group transition-transform duration-300 hover:scale-105"
              >
                <Image
                  src={take10Logo}
                  width={125}
                  height={125}
                  alt="Take 10"
                  class="size-28 rounded-full object-contain"
                />
              </a>


              <a
                href="/dosomegood/"
                class="group transition-transform duration-300 hover:scale-105"
              >
                <Image
                  src={doSomeGoodLogo}
                  width={125}
                  height={125}
                  alt="Do Some Good"
                  class="size-28 rounded-full object-contain"
                />
              </a>

            </div>


            <!-- LEARN MORE -->
            <div class="mt-7">

              <a
                href="#our-programmes"
                class="group inline-flex items-center gap-4 text-base font-medium text-white"
              >

                <span
                  class="border-b border-white pb-1 transition group-hover:border-orange-400"
                >
                  Learn more about our work
                </span>

                <span
                  class="text-2xl transition-transform duration-300 group-hover:translate-x-2"
                >
                  →
                </span>

              </a>

            </div>


            <!-- THREE VALUES -->
            <div class="mt-10 flex items-start">

              <!-- VALUE 1 -->
              <div class="flex w-36 flex-col items-center text-center">

                <div class="mb-3 text-3xl text-white">
                  ♧
                </div>

                <p class="text-sm font-semibold leading-tight text-white">
                  Stronger
                  <br />
                  communities
                </p>

              </div>


              <div class="h-16 w-px bg-white/40"></div>


              <!-- VALUE 2 -->
              <div class="flex w-36 flex-col items-center text-center">

                <div class="mb-3 text-3xl text-white">
                  ♡
                </div>

                <p class="text-sm font-semibold leading-tight text-white">
                  Real people
                  <br />
                  real impact
                </p>

              </div>


              <div class="h-16 w-px bg-white/40"></div>


              <!-- VALUE 3 -->
              <div class="flex w-36 flex-col items-center text-center">

                <div class="mb-3 text-3xl text-white">
                  ◇
                </div>

                <p class="text-sm font-semibold leading-tight text-white">
                  A fairer
                  <br />
                  brighter tomorrow
                </p>

              </div>

            </div>

          </div>

        </div>


        <!-- TOP RIGHT MESSAGE -->
        <div class="absolute right-10 top-28 hidden text-right md:block lg:right-16">

          <p
            class="font-serif text-2xl italic leading-tight text-white drop-shadow-lg"
          >
            Safer nights
            <br />
            Stronger communities
            <br />
            Brighter tomorrows
          </p>

          <div class="ml-auto mt-3 h-px w-36 bg-white"></div>

        </div>


        <!-- BOTTOM RIGHT QUOTE -->
        <div class="absolute bottom-28 right-10 hidden text-right md:block lg:right-16">

          <p
            class="font-serif text-lg italic leading-relaxed text-white drop-shadow-lg"
          >
            “Small actions,
            <br />
            big change.”
          </p>

          <div class="ml-auto mt-3 flex items-center justify-end gap-3">

            <span class="h-px w-10 bg-white"></span>

            <span class="text-white">
              →
            </span>

          </div>

        </div>


        <!-- SCROLL INDICATOR -->
        <div
          class="absolute bottom-24 left-1/2 hidden -translate-x-1/2 flex-col items-center text-white md:flex"
        >

          <div
            class="flex h-10 w-6 items-center justify-center rounded-full border border-white"
          >
            <div class="h-2 w-1 rounded-full bg-white"></div>
          </div>

          <span class="mt-2 text-[10px] font-semibold tracking-widest">
            SCROLL
          </span>

          <span class="mt-1 text-sm">
            ↓
          </span>

        </div>

      </div>

    </div>


    <!-- WHITE WAVE -->
    <div class="absolute inset-x-0 bottom-0 z-30 leading-none">

      <svg
        viewBox="0 0 1440 180"
        xmlns="http://www.w3.org/2000/svg"
        class="block h-28 w-full md:h-36 lg:h-40"
        preserveAspectRatio="none"
      >

        <path
          fill="#ffffff"
          d="
            M0,105
            C180,155 350,170 520,125
            C700,78 790,70 960,110
            C1130,150 1260,165 1440,105
            L1440,180
            L0,180
            Z
          "
        ></path>

      </svg>

    </div>

  </section>