---
import { getCollection, getEntry, render } from "astro:content";
import Layout from "@/components/layouts/Layout.astro";
import Section from "@/components/layouts/section.astro";
import FullSection from "@/components/layouts/full-section.astro";
import H2 from "@/components/headings/h2.astro";
import Programmes from "@/components/pages/home/Programmes.astro";
import { Quotes } from "@/components/pages/home/Quotes";
import NewsCard from "@/components/pages/news/NewsCard.astro";
import HowYouCanHelp from "@/components/pages/home/HowYouCanHelp.astro";
import { Picture, Image } from "astro:assets";
import take10Logo from "@/assets/img/logo/take10.png";
import doSomeGoodLogo from "@/assets/img/logo/dosomegood-new.png";
const posts = (await getCollection("posts", ({ data }) => data.published)).sort(
  (a, b) => Number(b.data.date) - Number(a.data.date),
);
const entry = await getEntry("pages", "index");
if (!entry) throw new Error("Could not find page");
const { Content } = await render(entry);
---
<Layout title={entry.data.title}>
  <div class="relative h-screen w-full overflow-hidden">
  <Picture
    src={import("@/assets/img/banner/home/home.png")}
    width={2200}
    height={300}
    formats={["avif", "webp"]}
    alt="Home banner"
    class="absolute inset-0 h-full w-full object-cover"
    priority={true}
    fetchpriority="high"
  />
  <div class="absolute inset-0 flex items-center justify-center bg-gradient-to-t from-black/80 via-black/40 to-black/10">
    <div class="text-center text-white px-6">
      <span class="inline-block bg-orange-500 text-white text-sm font-bold px-5 py-2 rounded-full mb-5">
        Wellington &amp; Auckland
      </span>
  <h1 class="text-3xl md:text-5xl lg:text-6xl font-bold">
    Supporting people, strengthening communities
  </h1>
  <p class="mt-4 text-lg md:text-2xl font-light">
    Working together for a better tomorrow
  </p>
      <div class="mt-8 flex justify-center items-center gap-8">
  <a href="/take10/" class="group flex flex-col items-center gap-2 hover:opacity-90 transition">
    <Image
      src={take10Logo}
      width={90}
      height={90}
      alt="Take 10"
      class="rounded-full object-contain shadow-lg group-hover:scale-105 transition-transform"
    />
    <span class="text-sm font-semibold">Take 10</span>
  </a>
  <a href="/dosomegood/" class="group flex flex-col items-center gap-2 hover:opacity-90 transition">
    <Image
      src={doSomeGoodLogo}
      width={90}
      height={90}
      alt="Do Some Good"
      class="rounded-full object-contain shadow-lg group-hover:scale-105 transition-transform"
    />
    <span class="text-sm font-semibold">Do Some Good</span>
  </a>
</div>
      <div class="mt-9">
        
          href="/about-us/"
          class="inline-block bg-white text-black font-bold px-8 py-3 rounded-full hover:bg-orange-500 hover:text-white transition"
        >
          Learn more about our work
        </a>
      </div>
</div>
  </div>
</div>
  <Section>
    <Programmes page={entry.data} />
  </Section>
  <Section>
    <H2>Working together for a better tomorrow</H2>
    <Content />
  </Section>
  <HowYouCanHelp />
  <FullSection>
    <H2>What people are saying</H2>
    <Quotes />
  </FullSection>
  <Section>
    <H2>Latest news</H2>
    <div class="mx-auto grid gap-6 sm:grid-cols-2 lg:grid-cols-3 lg:gap-9">
      {posts.slice(0, 3).map((post) => <NewsCard post={post} />)}
    </div>
  </Section>
</Layout>
