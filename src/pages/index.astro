---
import { getCollection, getEntry, render } from "astro:content";
import Layout from "@/components/layouts/Layout.astro";
import Section from "@/components/layouts/section.astro";
import FullSection from "@/components/layouts/full-section.astro";
import H2 from "@/components/headings/h2.astro";
import { Quotes } from "@/components/pages/home/Quotes";
import NewsCard from "@/components/pages/news/NewsCard.astro";
import HowYouCanHelp from "@/components/pages/home/HowYouCanHelp.astro";
import { Picture, Image } from "astro:assets";
import take10Logo from "@/assets/img/logo/take10.png";
import doSomeGoodLogo from "@/assets/img/logo/dosomegood-new.png";
import doSomeGoodPhoto from "@/assets/img/programmes/dosomegood.jpg";
import take10Photo from "@/assets/img/programmes/take10.jpg";

const posts = (await getCollection("posts", ({ data }) => data.published)).sort(
  (a, b) => Number(b.data.date) - Number(a.data.date),
);

const entry = await getEntry("pages", "index");
if (!entry) throw new Error("Could not find page");

const { Content } = await render(entry);
---

<Layout title={entry.data.title}>

  <!-- HERO -->
  <div class="relative w-full overflow-hidden bg-white pt-28 pb-20">

    <div class="mx-auto grid max-w-7xl items-center gap-10 px-5 lg:grid-cols-2 lg:px-8">

      <!-- LEFT: TEXT CONTENT -->
      <div class="relative z-10">

        <h1 class="text-3xl md:text-5xl font-bold text-gray-900 leading-tight">
          Supporting people, strengthening communities
        </h1>

        <p class="mt-4 text-lg md:text-xl text-gray-500">
          Working together for a better tomorrow
        </p>

        <div class="mt-6 flex items-center gap-4">

          <a href="/take10/" class="hover:opacity-80 transition">
            <Image
              src={take10Logo}
              width={80}
              height={80}
              alt="Take 10"
              class="rounded-full object-contain"
            />
          </a>

          <a href="/dosomegood/" class="hover:opacity-80 transition">
            <Image
              src={doSomeGoodLogo}
              width={80}
              height={80}
              alt="Do Some Good"
              class="rounded-full object-contain"
            />
          </a>

        </div>

        <div class="mt-6">
          <a href="#our-programmes" class="inline-flex items-center gap-2 text-sm font-semibold text-gray-900 underline underline-offset-4 hover:text-orange-500 transition">Learn more about our work<span aria-hidden="true">→</span></a>
        </div>

      </div>

      <!-- RIGHT: IMAGE -->
      <div class="relative h-[300px] md:h-[420px] lg:h-[480px] overflow-hidden rounded-3xl">
        <Picture
          src={import("@/assets/img/banner/home/home.png")}
          width={1200}
          height={900}
          formats={["avif", "webp"]}
          alt="Home banner"
          class="absolute inset-0 h-full w-full object-cover"
          priority={true}
          fetchpriority="high"
        />
      </div>

    </div>

    <!-- Wavy white bottom edge -->
    <div class="absolute inset-x-0 bottom-0 leading-none">
      <svg
        viewBox="0 0 1440 120"
        xmlns="http://www.w3.org/2000/svg"
        class="block w-full h-16 md:h-24"
        preserveAspectRatio="none"
      >
        <path
          fill="#ffffff"
          d="M0,64 C240,120 480,0 720,32 C960,64 1200,120 1440,64 L1440,120 L0,120 Z"
        ></path>
      </svg>
    </div>

  </div>


  <!-- OUR PROGRAMMES -->
  <Section id="our-programmes">

    <div class="text-center mb-12">
      <h2 class="text-4xl font-bold text-gray-900">Our Programmes</h2>
      <div class="mx-auto mt-4 h-1 w-20 bg-orange-500"></div>
    </div>

    <div class="grid gap-6 md:grid-cols-3">

      <a href="/dosomegood/" class="group relative block h-80 overflow-hidden rounded-2xl">
        <img
          src={doSomeGoodPhoto.src}
          alt="Do Some Good"
          class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
        />

        <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/10 to-transparent"></div>

        <div class="absolute bottom-0 left-0 right-0 p-6">
          <p class="text-white text-xl font-bold">Do Some Good</p>
          <p class="mt-1 text-sm text-white/80">
            Wellington, Porirua &amp; Hutt Valley
          </p>
        </div>
      </a>


      <a href="/take10/" class="group relative block h-80 overflow-hidden rounded-2xl">
        <img
          src={take10Photo.src}
          alt="Take 10 Wellington"
          class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
        />

        <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/10 to-transparent"></div>

        <div class="absolute bottom-0 left-0 right-0 p-6">
          <p class="text-white text-xl font-bold">Take 10 Wellington</p>
          <p class="mt-1 text-sm text-white/80">
            Fri &amp; Sat, 10pm–3am
          </p>
        </div>
      </a>


      <a href="/take10-auckland/" class="group relative block h-80 overflow-hidden rounded-2xl">
        <img
          src="/img/news/take10/take10-auckland.jpg"
          alt="Take 10 Auckland"
          class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
        />

        <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/10 to-transparent"></div>

        <div class="absolute bottom-0 left-0 right-0 p-6">
          <p class="text-white text-xl font-bold">Take 10 Auckland</p>
          <p class="mt-1 text-sm text-white/80">
            Fri &amp; Sat, 10pm–3am
          </p>
        </div>
      </a>

    </div>

  </Section>


  <!-- WHO WE ARE -->
  <Section>

    <div class="text-center max-w-3xl mx-auto mb-16">

      <p class="text-orange-500 text-sm font-semibold uppercase tracking-wide mb-3">
        Who we are
      </p>

      <H2>Working together for a better tomorrow</H2>

      <p class="mt-6 text-lg text-gray-600 leading-relaxed">
        Vulnerable Support Charitable Trust is a leading provider of support to those who are at risk of harm across Wellington, Porirua, and Hutt Valley. At the heart of our holistic practice model is a firm basis of reducing harm, promoting respect, and working towards an equitable future.
      </p>

    </div>


    <div class="grid gap-16">

      <div class="grid md:grid-cols-2 gap-8 items-center">

        <img
          src={doSomeGoodPhoto.src}
          alt="Do Some Good"
          class="rounded-2xl w-full h-72 object-cover"
        />

        <div>

          <p class="text-orange-500 text-sm font-semibold uppercase tracking-wide mb-2">
            Do Some Good
          </p>

          <p class="text-gray-700 leading-relaxed">
            A food support programme connecting local businesses wanting to do good, providing fresh and tasty kai for tamariki and their whānau in schools and kindergartens across Wellington, Porirua, and Hutt Valley. We also undertake regular volunteer days at the schools and kindergartens we support.
          </p>

          <a href="/dosomegood/" class="inline-block mt-4 text-sm font-semibold underline underline-offset-4 hover:text-orange-500 transition">Explore Do Some Good →</a>

        </div>

      </div>


      <div class="grid md:grid-cols-2 gap-8 items-center">

        <div class="md:order-2">

          <img
            src={take10Photo.src}
            alt="Take 10"
            class="rounded-2xl w-full h-72 object-cover"
          />

        </div>

        <div class="md:order-1">

          <p class="text-orange-500 text-sm font-semibold uppercase tracking-wide mb-2">
            Take 10
          </p>

          <p class="text-gray-700 leading-relaxed">
            A late night safe space operating from 10pm to 3am on Friday and Saturday nights, promoting safe nights out for students and others in the city. Take 10 runs in both Wellington, on the corner of Courtenay Place and Taranaki St, and in Tāmaki Makaurau, Auckland.
          </p>

          <a href="/take10/" class="inline-block mt-4 text-sm font-semibold underline underline-offset-4 hover:text-orange-500 transition">Explore Take 10 →</a>

        </div>

      </div>

    </div>


    <div class="mt-16 bg-gray-50 rounded-2xl p-10 text-center max-w-3xl mx-auto">

      <p class="text-lg text-gray-700 leading-relaxed">
        Our vision is for inclusive local communities where all people are prospering, able to achieve their goals, valued, and protected from harm. We respect all communities and provide support in a non-judgemental and inclusive manner.
      </p>

    </div>

  </Section>


  <HowYouCanHelp />


  <FullSection>

    <H2>What people are saying</H2>

    <Quotes />

  </FullSection>


  <Section>

    <H2>Latest news</H2>

    <div class="mx-auto grid gap-6 sm:grid-cols-2 lg:grid-cols-3 lg:gap-9">
      {posts.slice(0, 3).map((post) => <NewsCard post={post} />)}
    </div>

  </Section>

</Layout>


<style is:global>
  html {
    scroll-behavior: smooth;
  }
</style>