---
import { getCollection, getEntry, render } from "astro:content";
import Layout from "@/components/layouts/Layout.astro";
import Section from "@/components/layouts/section.astro";
import FullSection from "@/components/layouts/full-section.astro";
import H2 from "@/components/headings/h2.astro";
import { Quotes } from "@/components/pages/home/Quotes";
import NewsCard from "@/components/pages/news/NewsCard.astro";
import HowYouCanHelp from "@/components/pages/home/HowYouCanHelp.astro";
import { Picture, Image } from "astro:assets";
import take10Logo from "@/assets/img/logo/take10.png";
import doSomeGoodLogo from "@/assets/img/logo/dosomegood-new.png";
import doSomeGoodPhoto from "@/assets/img/programmes/dosomegood.jpg";
import take10Photo from "@/assets/img/programmes/take10.jpg";

const posts = (await getCollection("posts", ({ data }) => data.published)).sort(
  (a, b) => Number(b.data.date) - Number(a.data.date),
);

const entry = await getEntry("pages", "index");
if (!entry) throw new Error("Could not find page");

const { Content } = await render(entry);
---

<Layout title={entry.data.title}>

  <!-- HERO -->
  <section class="relative h-screen min-h-[700px] w-full overflow-hidden bg-white">

    <!-- MAIN IMAGE -->
    <Picture
      src={import("@/assets/img/banner/home/home.png")}
      width={2200}
      height={300}
      formats={["avif", "webp"]}
      alt="Home banner"
      class="absolute inset-0 h-full w-full object-cover"
      priority={true}
      fetchpriority="high"
    />

    <!-- WHITE SOFT EDGES -->
    <div
      class="absolute inset-0 z-10 pointer-events-none"
      style="
        background:
          radial-gradient(
            ellipse at center,
            transparent 42%,
            rgba(255,255,255,0.18) 62%,
            rgba(255,255,255,0.72) 84%,
            #ffffff 100%
          );
      "
    ></div>

    <!-- TOP WHITE FADE -->
    <div
      class="absolute inset-x-0 top-0 z-10 h-40 pointer-events-none"
      style="
        background: linear-gradient(
          to bottom,
          rgba(255,255,255,0.96),
          rgba(255,255,255,0.55),
          transparent
        );
      "
    ></div>

    <!-- LEFT WHITE FADE -->
    <div
      class="absolute inset-y-0 left-0 z-10 w-24 md:w-40 pointer-events-none"
      style="
        background: linear-gradient(
          to right,
          #ffffff,
          rgba(255,255,255,0.65),
          transparent
        );
      "
    ></div>

    <!-- RIGHT WHITE FADE -->
    <div
      class="absolute inset-y-0 right-0 z-10 w-24 md:w-40 pointer-events-none"
      style="
        background: linear-gradient(
          to left,
          #ffffff,
          rgba(255,255,255,0.65),
          transparent
        );
      "
    ></div>


    <!-- HERO CONTENT -->
    <div class="absolute inset-0 z-20">

      <div class="mx-auto flex h-full max-w-7xl items-center px-8 lg:px-12">

        <div class="grid w-full items-center gap-10 lg:grid-cols-2">

          <!-- LEFT SIDE -->
          <div class="max-w-2xl pt-16 lg:pt-0">

            <!-- SMALL EDITORIAL TEXT -->
            <div class="mb-5 flex items-center gap-3">
              <span class="h-px w-12 bg-white"></span>

              <span
                class="text-xs font-semibold uppercase tracking-[0.25em] text-white"
              >
                Safer nights
              </span>
            </div>

            <!-- MAIN TITLE -->
            <h1
              class="max-w-2xl text-4xl font-bold leading-[1.05] tracking-tight text-white drop-shadow-md sm:text-5xl md:text-6xl lg:text-7xl"
            >
              Supporting people,
              <br />
              strengthening
              <br />
              communities
            </h1>

            <!-- SUBTITLE -->
            <p
              class="mt-6 max-w-xl text-lg leading-relaxed text-white drop-shadow-md sm:text-xl md:text-2xl"
            >
              Working together for a better tomorrow
            </p>


            <!-- SMALL PHRASES -->
            <div class="mt-8 flex flex-wrap gap-x-6 gap-y-2">

              <span class="text-sm font-medium text-white">
                Stronger communities
              </span>

              <span class="text-white/70">•</span>

              <span class="text-sm font-medium text-white">
                Brighter tomorrows
              </span>

            </div>


            <!-- CTA -->
            <div class="mt-10">

              <a
                href="#our-programmes"
                class="group inline-flex items-center gap-4 text-sm font-semibold text-white transition"
              >
                <span
                  class="border-b border-white pb-1 transition group-hover:border-orange-400 group-hover:text-orange-300"
                >
                  Learn more about our work
                </span>

                <span
                  class="text-xl transition-transform duration-300 group-hover:translate-x-2"
                >
                  →
                </span>
              </a>

            </div>

          </div>


          <!-- RIGHT SIDE -->
          <div class="flex justify-center lg:justify-end">

            <div class="flex flex-col items-center gap-5 sm:flex-row">

              <!-- TAKE 10 -->
              <a
                href="/take10/"
                class="group relative"
              >
                <div
                  class="rounded-full bg-white/20 p-3 backdrop-blur-sm transition duration-300 group-hover:scale-105"
                >
                  <Image
                    src={take10Logo}
                    width={125}
                    height={125}
                    alt="Take 10"
                    class="size-24 rounded-full object-contain sm:size-28 md:size-32"
                  />
                </div>

                <div
                  class="mt-3 text-center text-xs font-semibold uppercase tracking-widest text-white opacity-0 transition group-hover:opacity-100"
                >
                  Take 10
                </div>
              </a>


              <!-- DO SOME GOOD -->
              <a
                href="/dosomegood/"
                class="group relative"
              >
                <div
                  class="rounded-full bg-white/20 p-3 backdrop-blur-sm transition duration-300 group-hover:scale-105"
                >
                  <Image
                    src={doSomeGoodLogo}
                    width={125}
                    height={125}
                    alt="Do Some Good"
                    class="size-24 rounded-full object-contain sm:size-28 md:size-32"
                  />
                </div>

                <div
                  class="mt-3 text-center text-xs font-semibold uppercase tracking-widest text-white opacity-0 transition group-hover:opacity-100"
                >
                  Do Some Good
                </div>
              </a>

            </div>

          </div>

        </div>

      </div>

    </div>


    <!-- WHITE WAVE -->
    <div class="absolute inset-x-0 bottom-0 z-30 leading-none">

      <svg
        viewBox="0 0 1440 180"
        xmlns="http://www.w3.org/2000/svg"
        class="block h-28 w-full md:h-36 lg:h-40"
        preserveAspectRatio="none"
      >
        <path
          fill="#ffffff"
          d="
            M0,105
            C180,155 350,170 520,125
            C700,78 790,70 960,110
            C1130,150 1260,165 1440,105
            L1440,180
            L0,180
            Z
          "
        ></path>
      </svg>

    </div>

  </section>


  <!-- OUR PROGRAMMES -->
  <Section id="our-programmes">

    <div class="mb-12 text-center">

      <h2 class="text-4xl font-bold text-gray-900">
        Our Programmes
      </h2>

      <div class="mx-auto mt-4 h-1 w-20 bg-orange-500"></div>

    </div>


    <div class="grid gap-6 md:grid-cols-3">

      <a
        href="/dosomegood/"
        class="group relative block h-80 overflow-hidden rounded-2xl"
      >

        <img
          src={doSomeGoodPhoto.src}
          alt="Do Some Good"
          class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
        />

        <div
          class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/10 to-transparent"
        ></div>

        <div class="absolute bottom-0 left-0 right-0 p-6">

          <p class="text-xl font-bold text-white">
            Do Some Good
          </p>

          <p class="mt-1 text-sm text-white/80">
            Wellington, Porirua &amp; Hutt Valley
          </p>

        </div>

      </a>


      <a
        href="/take10/"
        class="group relative block h-80 overflow-hidden rounded-2xl"
      >

        <img
          src={take10Photo.src}
          alt="Take 10 Wellington"
          class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
        />

        <div
          class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/10 to-transparent"
        ></div>

        <div class="absolute bottom-0 left-0 right-0 p-6">

          <p class="text-xl font-bold text-white">
            Take 10 Wellington
          </p>

          <p class="mt-1 text-sm text-white/80">
            Fri &amp; Sat, 10pm–3am
          </p>

        </div>

      </a>


      <a
        href="/take10-auckland/"
        class="group relative block h-80 overflow-hidden rounded-2xl"
      >

        <img
          src="/img/news/take10/take10-auckland.jpg"
          alt="Take 10 Auckland"
          class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
        />

        <div
          class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/10 to-transparent"
        ></div>

        <div class="absolute bottom-0 left-0 right-0 p-6">

          <p class="text-xl font-bold text-white">
            Take 10 Auckland
          </p>

          <p class="mt-1 text-sm text-white/80">
            Fri &amp; Sat, 10pm–3am
          </p>

        </div>

      </a>

    </div>

  </Section>


  <!-- WHO WE ARE -->
  <Section>

    <div class="mx-auto mb-16 max-w-3xl text-center">

      <p
        class="mb-3 text-sm font-semibold uppercase tracking-wide text-orange-500"
      >
        Who we are
      </p>

      <H2>
        Working together for a better tomorrow
      </H2>

      <p class="mt-6 text-lg leading-relaxed text-gray-600">
        Vulnerable Support Charitable Trust is a leading provider of support to those who are at risk of harm across Wellington, Porirua, and Hutt Valley. At the heart of our holistic practice model is a firm basis of reducing harm, promoting respect, and working towards an equitable future.
      </p>

    </div>


    <div class="grid gap-16">

      <div class="grid items-center gap-8 md:grid-cols-2">

        <img
          src={doSomeGoodPhoto.src}
          alt="Do Some Good"
          class="h-72 w-full rounded-2xl object-cover"
        />

        <div>

          <p
            class="mb-2 text-sm font-semibold uppercase tracking-wide text-orange-500"
          >
            Do Some Good
          </p>

          <p class="leading-relaxed text-gray-700">
            A food support programme connecting local businesses wanting to do good, providing fresh and tasty kai for tamariki and their whānau in schools and kindergartens across Wellington, Porirua, and Hutt Valley. We also undertake regular volunteer days at the schools and kindergartens we support.
          </p>

          <a
            href="/dosomegood/"
            class="mt-4 inline-block text-sm font-semibold underline underline-offset-4 transition hover:text-orange-500"
          >
            Explore Do Some Good →
          </a>

        </div>

      </div>


      <div class="grid items-center gap-8 md:grid-cols-2">

        <div class="md:order-2">

          <img
            src={take10Photo.src}
            alt="Take 10"
            class="h-72 w-full rounded-2xl object-cover"
          />

        </div>

        <div class="md:order-1">

          <p
            class="mb-2 text-sm font-semibold uppercase tracking-wide text-orange-500"
          >
            Take 10
          </p>

          <p class="leading-relaxed text-gray-700">
            A late night safe space operating from 10pm to 3am on Friday and Saturday nights, promoting safe nights out for students and others in the city. Take 10 runs in both Wellington, on the corner of Courtenay Place and Taranaki St, and in Tāmaki Makaurau, Auckland.
          </p>

          <a
            href="/take10/"
            class="mt-4 inline-block text-sm font-semibold underline underline-offset-4 transition hover:text-orange-500"
          >
            Explore Take 10 →
          </a>

        </div>

      </div>

    </div>


    <div
      class="mx-auto mt-16 max-w-3xl rounded-2xl bg-gray-50 p-10 text-center"
    >

      <p class="text-lg leading-relaxed text-gray-700">
        Our vision is for inclusive local communities where all people are prospering, able to achieve their goals, valued, and protected from harm. We respect all communities and provide support in a non-judgemental and inclusive manner.
      </p>

    </div>

  </Section>


  <HowYouCanHelp />


  <FullSection>

    <H2>
      What people are saying
    </H2>

    <Quotes />

  </FullSection>


  <Section>

    <H2>
      Latest news
    </H2>

    <div class="mx-auto grid gap-6 sm:grid-cols-2 lg:grid-cols-3 lg:gap-9">

      {posts.slice(0, 3).map((post) => (
        <NewsCard post={post} />
      ))}

    </div>

  </Section>

</Layout>


<style is:global>
  html {
    scroll-behavior: smooth;
  }
</style>