---
import { getCollection, getEntry, render } from "astro:content";
import Layout from "@/components/layouts/Layout.astro";
import Section from "@/components/layouts/section.astro";
import FullSection from "@/components/layouts/full-section.astro";
import H2 from "@/components/headings/h2.astro";
import { Quotes } from "@/components/pages/home/Quotes";
import NewsCard from "@/components/pages/news/NewsCard.astro";
import HowYouCanHelp from "@/components/pages/home/HowYouCanHelp.astro";
import { Picture, Image } from "astro:assets";
import take10Logo from "@/assets/img/logo/take10.png";
import doSomeGoodLogo from "@/assets/img/logo/dosomegood-new.png";
import doSomeGoodPhoto from "@/assets/img/programmes/dosomegood.jpg";
import take10Photo from "@/assets/img/programmes/take10.jpg";

const posts = (await getCollection("posts", ({ data }) => data.published)).sort(
  (a, b) => Number(b.data.date) - Number(a.data.date),
);

const entry = await getEntry("pages", "index");
if (!entry) throw new Error("Could not find page");

const { Content } = await render(entry);
---

<Layout title={entry.data.title}>

  <!-- HERO -->
  <section class="relative h-screen min-h-[760px] w-full overflow-hidden bg-white">

    <!-- MAIN IMAGE -->
    <Picture
      src={import("@/assets/img/banner/home/home.png")}
      width={2200}
      height={300}
      formats={["avif", "webp"]}
      alt="Home banner"
      class="absolute inset-0 h-full w-full object-cover"
      priority={true}
      fetchpriority="high"
    />

    <!-- DARK GRADIENT FOR TEXT LEGIBILITY -->
    <div
      class="absolute inset-0 z-10 pointer-events-none"
      style="
        background: linear-gradient(
          to right,
          rgba(0,0,0,0.55) 0%,
          rgba(0,0,0,0.25) 45%,
          rgba(0,0,0,0.1) 70%,
          rgba(0,0,0,0.35) 100%
        );
      "
    ></div>

    <!-- TOP WHITE FADE (sits under the site nav) -->
    <div
      class="absolute inset-x-0 top-0 z-10 h-32 pointer-events-none"
      style="
        background: linear-gradient(
          to bottom,
          rgba(0,0,0,0.45),
          transparent
        );
      "
    ></div>


    <!-- HERO CONTENT -->
    <div class="absolute inset-0 z-20 flex flex-col">

      <div class="mx-auto flex w-full max-w-7xl flex-1 items-center px-6 pt-20 lg:px-12">

        <div class="max-w-2xl">

          <!-- EYEBROW -->
          <p class="mb-4 text-xs font-semibold uppercase tracking-[0.25em] text-white/90">
            People &middot; Communities &middot; Brighter tomorrows
          </p>

          <!-- MAIN TITLE -->
          <h1
            class="text-4xl font-bold leading-[1.05] tracking-tight text-white sm:text-5xl md:text-6xl lg:text-7xl"
          >
            Supporting people,
            <br />
            strengthening
            <br />
            communities
          </h1>

          <!-- SUBTITLE -->
          <p class="mt-6 max-w-xl text-lg leading-relaxed text-white/90 sm:text-xl">
            Working together for a better tomorrow
          </p>

          <!-- PROGRAMME BADGES -->
          <div class="mt-8 flex items-center gap-5">

            <a href="/take10/" class="group flex items-center gap-3">
              <Image
                src={take10Logo}
                width={80}
                height={80}
                alt="Take 10"
                class="size-14 rounded-full bg-white object-contain p-1 shadow-md transition group-hover:scale-105 sm:size-16"
              />
            </a>

            <a href="/dosomegood/" class="group flex items-center gap-3">
              <Image
                src={doSomeGoodLogo}
                width={80}
                height={80}
                alt="Do Some Good"
                class="size-14 rounded-full bg-white object-contain p-1 shadow-md transition group-hover:scale-105 sm:size-16"
              />
            </a>

            <a
              href="#our-programmes"
              class="group ml-1 inline-flex items-center gap-3 text-sm font-semibold text-white"
            >
              <span class="border-b border-white pb-1 transition group-hover:border-orange-400 group-hover:text-orange-300">
                Learn more about our work
              </span>
              <span class="text-lg transition-transform duration-300 group-hover:translate-x-2">
                &rarr;
              </span>
            </a>

          </div>

          <!-- QUICK FACTS -->
          <div class="mt-14 grid max-w-xl grid-cols-3 gap-6">

            <div class="flex flex-col items-start gap-2">
              <svg class="size-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.7M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z" />
              </svg>
              <p class="text-sm font-semibold leading-snug text-white">
                Stronger communities
              </p>
            </div>

            <div class="flex flex-col items-start gap-2">
              <svg class="size-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z" />
              </svg>
              <p class="text-sm font-semibold leading-snug text-white">
                Real people, real impact
              </p>
            </div>

            <div class="flex flex-col items-start gap-2">
              <svg class="size-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 0 0 8.716-6.747M12 21a9.004 9.004 0 0 1-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 0 1 7.843 4.582M12 3a8.997 8.997 0 0 0-7.843 4.582m15.686 0A11.953 11.953 0 0 1 12 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0 1 21 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0 1 12 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 0 1 3 12c0-1.605.42-3.113 1.157-4.418" />
              </svg>
              <p class="text-sm font-semibold leading-snug text-white">
                A fairer, brighter tomorrow
              </p>
            </div>

          </div>

        </div>

      </div>

      <!-- SCROLL INDICATOR -->
      <div class="mb-24 flex flex-col items-center gap-2 text-white/90">
        <svg class="size-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <rect x="8" y="3" width="8" height="14" rx="4" />
          <circle cx="12" cy="8" r="1.2" fill="currentColor" stroke="none" />
        </svg>
        <span class="text-[10px] font-semibold uppercase tracking-[0.3em]">
          Scroll
        </span>
      </div>

    </div>


    <!-- WHITE WAVE -->
    <div class="absolute inset-x-0 bottom-0 z-30 leading-none">

      <svg
        viewBox="0 0 1440 180"
        xmlns="http://www.w3.org/2000/svg"
        class="block h-24 w-full md:h-32 lg:h-36"
        preserveAspectRatio="none"
      >
        <path
          fill="#ffffff"
          d="
            M0,105
            C180,155 350,170 520,125
            C700,78 790,70 960,110
            C1130,150 1260,165 1440,105
            L1440,180
            L0,180
            Z
          "
        ></path>
      </svg>

    </div>

  </section>


  <!-- OUR PROGRAMMES -->
  <Section id="our-programmes">

    <div class="mb-12 text-center">

      <p class="mb-3 text-sm font-semibold uppercase tracking-wide text-orange-500">
        Our programmes
      </p>

      <h2 class="text-4xl font-bold text-gray-900">
        Making a difference through action
      </h2>

    </div>


    <div class="grid gap-6 md:grid-cols-3">

      <a
        href="/dosomegood/"
        class="group relative block h-80 overflow-hidden rounded-2xl"
      >

        <img
          src={doSomeGoodPhoto.src}
          alt="Do Some Good"
          class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
        />

        <div
          class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/10 to-transparent"
        ></div>

        <div class="absolute bottom-0 left-0 right-0 p-6">

          <p class="text-xl font-bold text-white">
            Do Some Good
          </p>

          <p class="mt-1 text-sm text-white/80">
            Wellington, Porirua &amp; Hutt Valley
          </p>

        </div>

      </a>


      <a
        href="/take10/"
        class="group relative block h-80 overflow-hidden rounded-2xl"
      >

        <img
          src={take10Photo.src}
          alt="Take 10 Wellington"
          class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
        />

        <div
          class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/10 to-transparent"
        ></div>

        <div class="absolute bottom-0 left-0 right-0 p-6">

          <p class="text-xl font-bold text-white">
            Take 10 Wellington
          </p>

          <p class="mt-1 text-sm text-white/80">
            Fri &amp; Sat, 10pm&ndash;3am
          </p>

        </div>

      </a>


      <a
        href="/take10-auckland/"
        class="group relative block h-80 overflow-hidden rounded-2xl"
      >

        <img
          src="/img/news/take10/take10-auckland.jpg"
          alt="Take 10 Auckland"
          class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
        />

        <div
          class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/10 to-transparent"
        ></div>

        <div class="absolute bottom-0 left-0 right-0 p-6">

          <p class="text-xl font-bold text-white">
            Take 10 Auckland
          </p>

          <p class="mt-1 text-sm text-white/80">
            Fri &amp; Sat, 10pm&ndash;3am
          </p>

        </div>

      </a>

    </div>

  </Section>


  <!-- WHO WE ARE -->
  <Section>

    <div class="mx-auto mb-16 max-w-3xl text-center">

      <p
        class="mb-3 text-sm font-semibold uppercase tracking-wide text-orange-500"
      >
        Who we are
      </p>

      <H2>
        Working together for a better tomorrow
      </H2>

      <p class="mt-6 text-lg leading-relaxed text-gray-600">
        Vulnerable Support Charitable Trust is a leading provider of support to those who are at risk of harm across Wellington, Porirua, and Hutt Valley. At the heart of our holistic practice model is a firm basis of reducing harm, promoting respect, and working towards an equitable future.
      </p>

    </div>


    <div class="grid gap-16">

      <div class="grid items-center gap-8 md:grid-cols-2">

        <img
          src={doSomeGoodPhoto.src}
          alt="Do Some Good"
          class="h-72 w-full rounded-2xl object-cover"
        />

        <div>

          <p
            class="mb-2 text-sm font-semibold uppercase tracking-wide text-orange-500"
          >
            Do Some Good
          </p>

          <p class="leading-relaxed text-gray-700">
            A food support programme connecting local businesses wanting to do good, providing fresh and tasty kai for tamariki and their whānau in schools and kindergartens across Wellington, Porirua, and Hutt Valley. We also undertake regular volunteer days at the schools and kindergartens we support.
          </p>

          <a
            href="/dosomegood/"
            class="mt-4 inline-block text-sm font-semibold underline underline-offset-4 transition hover:text-orange-500"
          >
            Explore Do Some Good →
          </a>

        </div>

      </div>


      <div class="grid items-center gap-8 md:grid-cols-2">

        <div class="md:order-2">

          <img
            src={take10Photo.src}
            alt="Take 10"
            class="h-72 w-full rounded-2xl object-cover"
          />

        </div>

        <div class="md:order-1">

          <p
            class="mb-2 text-sm font-semibold uppercase tracking-wide text-orange-500"
          >
            Take 10
          </p>

          <p class="leading-relaxed text-gray-700">
            A late night safe space operating from 10pm to 3am on Friday and Saturday nights, promoting safe nights out for students and others in the city. Take 10 runs in both Wellington, on the corner of Courtenay Place and Taranaki St, and in Tāmaki Makaurau, Auckland.
          </p>

          <a
            href="/take10/"
            class="mt-4 inline-block text-sm font-semibold underline underline-offset-4 transition hover:text-orange-500"
          >
            Explore Take 10 →
          </a>

        </div>

      </div>

    </div>


    <div
      class="mx-auto mt-16 max-w-3xl rounded-2xl bg-gray-50 p-10 text-center"
    >

      <p class="text-lg leading-relaxed text-gray-700">
        Our vision is for inclusive local communities where all people are prospering, able to achieve their goals, valued, and protected from harm. We respect all communities and provide support in a non-judgemental and inclusive manner.
      </p>

    </div>

  </Section>


  <HowYouCanHelp />


  <FullSection>

    <H2>
      What people are saying
    </H2>

    <Quotes />

  </FullSection>


  <Section>

    <H2>
      Latest news
    </H2>

    <div class="mx-auto grid gap-6 sm:grid-cols-2 lg:grid-cols-3 lg:gap-9">

      {posts.slice(0, 3).map((post) => (
        <NewsCard post={post} />
      ))}

    </div>

  </Section>

</Layout>


<style is:global>
  html {
    scroll-behavior: smooth;
  }
</style>