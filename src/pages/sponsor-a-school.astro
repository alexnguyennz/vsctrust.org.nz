---
import { getEntry, render } from "astro:content";
import { Image } from "astro:assets";

import Layout from "@/components/layouts/Layout.astro";
import Form from "@/components/Form.astro";
import { Label } from "@/components/ui/label";
import { Input } from "@/components/ui/input";
import { Textarea } from "@/components/ui/textarea";

const entry = await getEntry("pages", "sponsor-a-school");
if (!entry) throw new Error("Could not find page");

const { Content } = await render(entry);
---

<Layout title={entry.data.title}>

  <main class="bg-white">

    <section class="mx-auto max-w-7xl px-6 pb-20 pt-24 lg:px-10 lg:pt-28">

      <!-- ========================================= -->
      <!-- HEADER / TITLE -->
      <!-- ========================================= -->

      <div class="relative mb-12">

        <div class="max-w-2xl">

          <div class="mb-4 flex items-center gap-4">
            <span class="text-sm font-bold uppercase tracking-[0.22em] text-orange-500">
              Get involved
            </span>

            <span class="h-px w-16 bg-orange-500"></span>
          </div>

          <h1 class="text-[56px] font-bold leading-[0.98] tracking-[-0.045em] text-slate-950 md:text-[64px] lg:text-[70px]">
            Sponsor a School
          </h1>

          <p class="mt-5 max-w-xl text-xl leading-relaxed text-stone-500">
            Support Do Some Good and help provide meaningful support to schools
            and kindergartens across our communities.
          </p>

        </div>


        <!-- SCHOOL ICON -->

        <div class="absolute right-8 top-0 hidden lg:block">

          <div class="relative flex h-40 w-40 items-center justify-center rounded-full bg-orange-50">

            <Image
              src={import("@/assets/img/home/sponsor.png")}
              width="77"
              height="77"
              alt="Sponsor a school"
              class="h-24 w-24 object-contain"
            />

            <span class="absolute -right-5 top-1 h-8 w-1.5 rotate-[25deg] rounded-full bg-orange-500"></span>

            <span class="absolute -right-10 top-10 h-1.5 w-7 rotate-[-25deg] rounded-full bg-orange-500"></span>

            <span class="absolute -right-8 top-24 h-1.5 w-6 rotate-[-10deg] rounded-full bg-orange-500"></span>

          </div>

        </div>

      </div>


      <!-- ========================================= -->
      <!-- PHOTO + FORM -->
      <!-- ========================================= -->

      <div class="grid items-start gap-10 lg:grid-cols-[1.08fr_0.92fr]">

        <!-- ======================================= -->
        <!-- LEFT SIDE -->
        <!-- ======================================= -->

        <div>

          <div class="relative">

            <Image
              src={import("@/assets/img/banner/sponsor-a-school.jpg")}
              width="900"
              height="650"
              alt="Do Some Good"
              fetchpriority="high"
              loading="eager"
              class="h-[480px] w-full rounded-[2rem] object-cover"
            />

            <!-- ORANGE DOODLE -->

            <div class="absolute -bottom-5 -left-5">

              <span class="block h-1.5 w-7 rotate-[25deg] rounded-full bg-orange-500"></span>

              <span class="ml-2 mt-2 block h-1.5 w-4 rotate-[-20deg] rounded-full bg-orange-500"></span>

              <span class="ml-6 mt-1 block h-1.5 w-6 rotate-[15deg] rounded-full bg-orange-500"></span>

            </div>

          </div>


          <!-- ===================================== -->
          <!-- THREE BENEFITS -->
          <!-- ===================================== -->

          <div class="mt-10 grid grid-cols-3">

            <!-- STRONGER COMMUNITIES -->

            <div class="flex items-center gap-4 pr-5">

              <div class="flex h-16 w-16 shrink-0 items-center justify-center rounded-full bg-orange-50">

                <svg
                  viewBox="0 0 64 64"
                  class="h-8 w-8 text-orange-500"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="3"
                >
                  <circle cx="32" cy="17" r="7" />
                  <circle cx="14" cy="24" r="6" />
                  <circle cx="50" cy="24" r="6" />
                  <path d="M18 49c0-10 6-16 14-16s14 6 14 16" />
                  <path d="M3 47c0-7 4-12 11-12 4 0 7 2 9 6" />
                  <path d="M61 47c0-7-4-12-11-12-4 0-7 2-9 6" />
                </svg>

              </div>

              <div>

                <p class="font-bold leading-tight text-slate-950">
                  Stronger<br />
                  communities
                </p>

                <p class="mt-1 text-sm leading-tight text-stone-500">
                  Helping tamariki<br />
                  and families thrive.
                </p>

              </div>

            </div>


            <!-- BRIGHTER OPPORTUNITIES -->

            <div class="flex items-center gap-4 border-l border-stone-300 px-5">

              <div class="flex h-16 w-16 shrink-0 items-center justify-center rounded-full bg-orange-50">

                <svg
                  viewBox="0 0 64 64"
                  class="h-8 w-8 text-orange-500"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="3"
                >
                  <path d="M8 22h48L32 9 8 22Z" />
                  <path d="M14 26h36" />
                  <path d="M18 26v21" />
                  <path d="M46 26v21" />
                  <path d="M9 49h46" />
                  <path d="M27 49V35h10v14" />
                </svg>

              </div>

              <div>

                <p class="font-bold leading-tight text-slate-950">
                  Brighter<br />
                  opportunities
                </p>

                <p class="mt-1 text-sm leading-tight text-stone-500">
                  Supporting education<br />
                  and wellbeing.
                </p>

              </div>

            </div>


            <!-- A LASTING IMPACT -->

            <div class="flex items-center gap-4 border-l border-stone-300 pl-5">

              <div class="flex h-16 w-16 shrink-0 items-center justify-center rounded-full bg-orange-50">

                <svg
                  viewBox="0 0 64 64"
                  class="h-8 w-8 text-orange-500"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="3"
                >
                  <path d="M32 53S10 40 10 24c0-8 5-13 12-13 5 0 9 3 10 7 1-4 5-7 10-7 7 0 12 5 12 13 0 16-22 29-22 29Z" />
                </svg>

              </div>

              <div>

                <p class="font-bold leading-tight text-slate-950">
                  A lasting<br />
                  impact
                </p>

                <p class="mt-1 text-sm leading-tight text-stone-500">
                  Creating positive<br />
                  change together.
                </p>

              </div>

            </div>

          </div>


          <!-- ===================================== -->
          <!-- ORIGINAL REAL CONTENT -->
          <!-- ===================================== -->

          <div class="prose prose-stone mt-12 max-w-none">
            <Content />
          </div>

        </div>


        <!-- ======================================= -->
        <!-- FORM CARD -->
        <!-- ======================================= -->

        <div class="rounded-[2rem] bg-[#fff8ef] p-8 lg:p-10">

          <!-- HEART -->

          <div class="flex justify-end">

            <svg
              viewBox="0 0 64 64"
              class="h-14 w-14 text-orange-500"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
            >
              <path d="M32 53S10 40 10 24c0-8 5-13 12-13 5 0 9 3 10 7 1-4 5-7 10-7 7 0 12 5 12 13 0 16-22 29-22 29Z" />
            </svg>

          </div>


          <div class="mb-7 flex items-center gap-4">

            <span class="h-px w-10 bg-orange-500"></span>

            <span class="text-sm font-bold uppercase tracking-[0.2em] text-orange-500">
              Get in touch
            </span>

          </div>


          <h2 class="max-w-md text-4xl font-bold leading-[0.98] tracking-[-0.04em] text-slate-950">
            Let’s do some<br />
            good together.
          </h2>


          <p class="mt-5 text-base leading-relaxed text-stone-600">
            Interested in sponsoring a school?
            Fill out the form below and our team will be in touch.
          </p>


          <div class="mt-8">

            <Form name="sponsor">

              <div>
                <Label htmlFor="name" className="required">
                  Name
                </Label>

                <Input
                  className="mt-2 h-14 rounded-xl border-stone-200 bg-white shadow-none"
                  type="text"
                  id="name"
                  name="name"
                  placeholder="Your name"
                  required
                />
              </div>


              <div>
                <Label htmlFor="email" className="required">
                  Email
                </Label>

                <Input
                  className="mt-2 h-14 rounded-xl border-stone-200 bg-white shadow-none"
                  type="email"
                  id="email"
                  name="email"
                  placeholder="Your email address"
                  required
                />
              </div>


              <div>
                <Label htmlFor="phone">
                  Phone Number
                </Label>

                <Input
                  className="mt-2 h-14 rounded-xl border-stone-200 bg-white shadow-none"
                  type="tel"
                  id="phone"
                  name="phone"
                  placeholder="Your phone number"
                />
              </div>


              <div>
                <Label htmlFor="website">
                  Website
                </Label>

                <Input
                  className="mt-2 h-14 rounded-xl border-stone-200 bg-white shadow-none"
                  type="url"
                  id="website"
                  name="website"
                  placeholder="Your website (optional)"
                />
              </div>


              <div class="sm:col-span-2">

                <Label htmlFor="message" className="required">
                  Message
                </Label>

                <Textarea
                  className="mt-2 min-h-[140px] rounded-xl border-stone-200 bg-white shadow-none"
                  id="message"
                  name="message"
                  rows={5}
                  placeholder="Tell us more about your interest in sponsoring a school..."
                  required
                />

              </div>

            </Form>

          </div>

        </div>

      </div>

    </section>

  </main>

</Layout>