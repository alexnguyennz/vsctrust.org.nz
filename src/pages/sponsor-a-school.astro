---
import { getEntry, render } from "astro:content";
import { Image } from "astro:assets";

import Layout from "@/components/layouts/Layout.astro";
import AnchorButton from "@/components/layouts/anchor-button.astro";

import Form from "@/components/Form.astro";
import { Label } from "@/components/ui/label";
import { Input } from "@/components/ui/input";
import { Textarea } from "@/components/ui/textarea";

const entry = await getEntry("pages", "sponsor-a-school");
if (!entry) throw new Error("Could not find page");

const { Content } = await render(entry);
---

<Layout title={entry.data.title}>

  <main class="bg-white">

    <!-- ========================================= -->
    <!-- HERO / INTRO -->
    <!-- ========================================= -->

    <section class="mx-auto max-w-7xl px-8 pb-8 pt-16 lg:px-12">

      <div class="relative">

        <!-- GET INVOLVED -->

        <div class="mb-5 flex items-center gap-4">

          <span
            class="text-sm font-bold uppercase tracking-[0.16em] text-orange-500"
          >
            Get involved
          </span>

          <span class="h-px w-12 bg-orange-500"></span>

        </div>


        <!-- TITLE + SCHOOL -->

        <div class="relative">

          <h1
            class="max-w-2xl text-5xl font-bold leading-[0.95] tracking-[-0.045em] text-gray-950 md:text-6xl lg:text-[4.5rem]"
          >
            {entry.data.title}
          </h1>


          <!-- SUBTITLE -->

          <p
            class="mt-4 max-w-xl text-lg leading-relaxed text-stone-500 md:text-xl"
          >
            Support Do Some Good and help provide meaningful support to
            schools and kindergartens across our communities.
          </p>


          <!-- SCHOOL ILLUSTRATION -->

          <div
            class="absolute right-[17%] top-1/2 hidden -translate-y-[45%] md:block"
          >

            <div class="relative">

              <!-- CIRCLE -->

              <div
                class="flex h-36 w-36 items-center justify-center rounded-full bg-orange-50"
              >

                <Image
                  src={import("@/assets/img/home/sponsor.png")}
                  width="77"
                  height="77"
                  alt="Sponsor a school"
                  fetchpriority="high"
                  loading="eager"
                  class="h-24 w-24 object-contain"
                />

              </div>


              <!-- ORANGE DECORATION -->

              <span
                class="absolute -right-5 -top-5 h-7 w-1 rotate-[25deg] rounded-full bg-orange-500"
              ></span>

              <span
                class="absolute -right-10 top-2 h-5 w-1 rotate-[55deg] rounded-full bg-orange-500"
              ></span>

              <span
                class="absolute -right-7 top-10 h-6 w-1 rotate-[75deg] rounded-full bg-orange-500"
              ></span>

            </div>

          </div>

        </div>

      </div>

    </section>


    <!-- ========================================= -->
    <!-- PHOTO + FORM -->
    <!-- ========================================= -->

    <section class="mx-auto max-w-7xl px-8 pb-10 lg:px-12">

      <div
        class="grid items-start gap-8 lg:grid-cols-[1.12fr_0.88fr]"
      >


        <!-- ===================================== -->
        <!-- LEFT -->
        <!-- ===================================== -->

        <div>

          <!-- PHOTO -->

          <div class="relative">

            <div class="overflow-hidden rounded-[2rem]">

              <Image
                src={import("@/assets/img/banner/sponsor-a-school.jpg")}
                width="900"
                height="650"
                alt="Do Some Good"
                fetchpriority="high"
                loading="eager"
                class="h-[365px] w-full object-cover md:h-[390px]"
              />

            </div>


            <!-- ORANGE DECORATION -->

            <div class="absolute -bottom-5 -left-7">

              <span
                class="absolute left-0 top-0 h-7 w-1 rotate-[35deg] rounded-full bg-orange-500"
              ></span>

              <span
                class="absolute left-5 -top-5 h-5 w-1 rotate-[65deg] rounded-full bg-orange-500"
              ></span>

              <span
                class="absolute left-7 top-3 h-6 w-1 rotate-[90deg] rounded-full bg-orange-500"
              ></span>

            </div>

          </div>


          <!-- THREE IMPACT ITEMS -->

          <div class="mt-7 grid grid-cols-3">

            <!-- ITEM 1 -->

            <div
              class="flex items-center gap-3 border-r border-stone-300 pr-5"
            >

              <div
                class="flex h-14 w-14 flex-shrink-0 items-center justify-center rounded-full bg-orange-50 text-2xl text-orange-500"
              >
                ♧
              </div>

              <div>

                <h3
                  class="text-sm font-bold leading-tight text-gray-950"
                >
                  Stronger<br />communities
                </h3>

                <p
                  class="mt-1 text-xs leading-tight text-stone-500"
                >
                  Helping tamariki<br />
                  and families thrive.
                </p>

              </div>

            </div>


            <!-- ITEM 2 -->

            <div
              class="flex items-center gap-3 border-r border-stone-300 px-5"
            >

              <div
                class="flex h-14 w-14 flex-shrink-0 items-center justify-center rounded-full bg-orange-50 text-2xl text-orange-500"
              >
                🎓
              </div>

              <div>

                <h3
                  class="text-sm font-bold leading-tight text-gray-950"
                >
                  Brighter<br />opportunities
                </h3>

                <p
                  class="mt-1 text-xs leading-tight text-stone-500"
                >
                  Supporting education<br />
                  and wellbeing.
                </p>

              </div>

            </div>


            <!-- ITEM 3 -->

            <div
              class="flex items-center gap-3 pl-5"
            >

              <div
                class="flex h-14 w-14 flex-shrink-0 items-center justify-center rounded-full bg-orange-50 text-3xl font-light text-orange-500"
              >
                ♡
              </div>

              <div>

                <h3
                  class="text-sm font-bold leading-tight text-gray-950"
                >
                  A lasting<br />impact
                </h3>

                <p
                  class="mt-1 text-xs leading-tight text-stone-500"
                >
                  Creating positive<br />
                  change together.
                </p>

              </div>

            </div>

          </div>


          <!-- KEEP THE REAL CONTENT -->
          <!-- It remains below the redesigned section -->

          <div
            class="mt-10 max-w-2xl text-base leading-relaxed text-stone-600"
          >
            <Content />
          </div>


          <!-- BROCHURE -->

          <div class="mt-6">

            <AnchorButton
              href="/dosomegood/brochure.pdf"
              class="rounded-full bg-gray-950 px-7 py-3 text-sm font-semibold text-white transition hover:bg-orange-500"
            >
              Brochure
            </AnchorButton>

          </div>

        </div>


        <!-- ===================================== -->
        <!-- RIGHT / FORM -->
        <!-- ===================================== -->

        <div
          class="relative rounded-[2rem] bg-orange-50/70 px-7 py-8 md:px-8 md:py-9"
        >

          <!-- HEART -->

          <div class="absolute right-7 top-5">

            <span
              class="text-6xl font-light leading-none text-orange-500"
            >
              ♡
            </span>

            <span
              class="absolute -right-3 -top-1 text-2xl text-orange-500"
            >
              ˙
            </span>

          </div>


          <!-- FORM TITLE -->

          <div class="pr-14">

            <h2
              class="text-3xl font-bold leading-[0.98] tracking-[-0.04em] text-gray-950 md:text-4xl"
            >
              Let’s do some<br />
              good together.
            </h2>

            <p
              class="mt-4 text-sm leading-relaxed text-stone-600"
            >
              Interested in sponsoring a school?<br />
              Fill out the form below and our team will be in touch.
            </p>

          </div>


          <!-- FORM -->

          <div class="mt-7">

            <Form name="sponsor">

              <!-- NAME -->

              <div>

                <Label
                  htmlFor="name"
                  className="required"
                >
                  Name
                </Label>

                <Input
                  className="mt-2 rounded-xl border border-stone-300 bg-white shadow-none"
                  type="text"
                  id="name"
                  name="name"
                  required
                  placeholder="Your name"
                />

              </div>


              <!-- EMAIL -->

              <div>

                <Label
                  htmlFor="email"
                  className="required"
                >
                  Email
                </Label>

                <Input
                  className="mt-2 rounded-xl border border-stone-300 bg-white shadow-none"
                  type="email"
                  id="email"
                  name="email"
                  required
                  placeholder="Your email address"
                />

              </div>


              <!-- PHONE -->

              <div>

                <Label htmlFor="phone">
                  Phone Number
                </Label>

                <Input
                  className="mt-2 rounded-xl border border-stone-300 bg-white shadow-none"
                  type="tel"
                  id="phone"
                  name="phone"
                  placeholder="Your phone number"
                />

              </div>


              <!-- WEBSITE -->

              <div>

                <Label htmlFor="website">
                  Website
                </Label>

                <Input
                  className="mt-2 rounded-xl border border-stone-300 bg-white shadow-none"
                  type="url"
                  id="website"
                  name="website"
                  placeholder="Your website (optional)"
                />

              </div>


              <!-- MESSAGE -->

              <div class="sm:col-span-2">

                <Label
                  htmlFor="message"
                  className="required"
                >
                  Message
                </Label>

                <Textarea
                  className="mt-2 min-h-24 rounded-xl border border-stone-300 bg-white shadow-none"
                  id="message"
                  name="message"
                  rows={4}
                  required
                  placeholder="Tell us more about your interest in sponsoring a school..."
                />

              </div>

            </Form>

          </div>


          <!-- SUBMIT BUTTON -->

          <button
            type="submit"
            form="sponsor"
            class="mt-5 flex w-full items-center justify-center gap-3 rounded-full bg-orange-500 px-6 py-4 text-sm font-bold uppercase tracking-wide text-white transition hover:bg-orange-600"
          >
            Send enquiry
            <span class="text-lg">→</span>
          </button>

        </div>

      </div>

    </section>

  </main>

</Layout>


<style>
  :global(html) {
    scroll-behavior: smooth;
  }


  :global(form[name="sponsor"]) {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.9rem;
  }


  @media (min-width: 640px) {
    :global(form[name="sponsor"]) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }


  :global(form[name="sponsor"] > div:nth-child(5)) {
    grid-column: 1 / -1;
  }


  :global(form[name="sponsor"] input),
  :global(form[name="sponsor"] textarea) {
    width: 100%;
  }


  :global(form[name="sponsor"] input::placeholder),
  :global(form[name="sponsor"] textarea::placeholder) {
    color: #a8a29e;
    opacity: 1;
  }
</style>