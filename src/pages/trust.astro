---
import { getCollection } from "astro:content";

import Layout from "@/components/layouts/Layout.astro";
import TeamMember from "@/components/pages/team/TeamMember.astro";

const trustMembers = (await getCollection("trust")).sort(
  (a, b) => a.data.order - b.data.order,
);

const title = "The Trust";
---

<Layout title={title}>

  <section class="bg-white">

    <div class="mx-auto max-w-6xl px-6 pb-20 pt-16 lg:px-10 lg:pt-20">

      {
        trustMembers.map((trust) => (
          <TeamMember
            trust={trust}
            category="trust"
          />
        ))
      }

    </div>

  </section>

</Layout>