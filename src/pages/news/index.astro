---
import { getCollection } from "astro:content";

import Layout from "@/components/layouts/Layout.astro";
import Section from "@/components/layouts/section.astro";

import NewsGrid from "@/components/pages/news/NewsGrid.astro";
import NewsCard from "@/components/pages/news/NewsCard.astro";
import Pagination from "@/components/pages/news/Pagination.astro";

const posts = (await getCollection("posts", ({ data }) => data.published)).sort(
  (a, b) => Number(b.data.date) - Number(a.data.date),
);

const title = "News";
---

<Layout title={title}>

  <!-- =====================================================
       NEWS HERO
       ===================================================== -->

  <section class="w-full bg-[#FDF4EA] pb-14 pt-28 sm:pt-32 lg:pb-16 lg:pt-36">

    <div class="mx-auto max-w-7xl px-6 lg:px-10">

      <div class="mb-5 flex items-center gap-4">

        <span
          class="text-sm font-bold uppercase tracking-[0.18em] text-orange-500"
        >
          Our News
        </span>

        <span class="h-px w-12 bg-orange-500"></span>

      </div>

      <h1
        class="text-4xl font-bold leading-[1.05] tracking-tight text-gray-950 sm:text-5xl"
      >
        Latest News &amp; Updates
      </h1>

      <p class="mt-4 max-w-xl text-lg leading-relaxed text-gray-700">
        Stay up to date with what's happening at Vulnerable Support
        Charitable Trust.
      </p>

    </div>

  </section>


  <!-- =====================================================
       NEWS GRID
       ===================================================== -->

  <div class="bg-white">

    <Section class="space-y-6">
      <NewsGrid>
        {posts.slice(0, 8).map((post) => <NewsCard post={post} />)}
      </NewsGrid>

      <Pagination nextUrl="/news/2/" />
    </Section>

  </div>

</Layout>