
---
import { getEntry, render } from "astro:content";
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import { marked } from "marked";

import Layout from "@/components/layouts/Layout.astro";
import Section from "@/components/layouts/section.astro";

const entry = await getEntry("pages", "support-us");
if (!entry) throw new Error("Could not find page");

const { Content } = await render(entry);
---

<Layout title={entry.data.title}>
  <main class="mx-auto max-w-7xl px-6 pb-16 pt-12 lg:px-10 lg:pt-16">

    <!-- HERO -->
    <section class="relative mb-12 lg:mb-16">

      <div class="grid items-center gap-8 lg:grid-cols-[1fr_220px]">

        <div>
          <div class="mb-4 flex items-center gap-3">
            <span class="text-sm font-semibold uppercase tracking-[0.2em] text-orange-600">
              Get Involved
            </span>
            <span class="h-px w-14 bg-orange-500"></span>
          </div>

          <h1 class="text-5xl font-extrabold tracking-tight text-gray-950 sm:text-6xl lg:text-7xl">
            {entry.data.title}
          </h1>

          <div class="mt-5 max-w-2xl text-lg leading-relaxed text-gray-500">
            <Fragment set:html={marked.parse(entry.data.topContent)} />
          </div>
        </div>

        <div class="mx-auto flex size-40 items-center justify-center rounded-full bg-orange-50 lg:size-48">
          <Image
            src={import("@/assets/img/home/donate.png")}
            width={100}
            height={100}
            alt="Donation"
            fetchpriority="high"
            loading="eager"
            class="size-24 object-contain lg:size-28"
            transition:name="donate"
          />
        </div>

      </div>
    </section>


    <!-- MAIN CONTENT -->
    <section class="grid items-start gap-10 lg:grid-cols-[1.15fr_0.85fr] lg:gap-12">

      <!-- LEFT COLUMN -->
      <div class="min-w-0">

        <div class="relative">
          <Image
            src={import("@/assets/img/banner/support-us.jpg")}
            width={900}
            height={650}
            alt="Do Some Good team supporting the community"
            fetchpriority="high"
            loading="eager"
            class="aspect-[4/3] w-full rounded-3xl object-cover shadow-sm"
          />

          <span class="absolute -bottom-3 -left-3 text-4xl font-light text-orange-500">
            ~
          </span>
        </div>

        <!-- DONATION INFORMATION -->
        <div class="mt-10">

          <div class="mb-6 flex items-center gap-3">
            <span class="h-px w-10 bg-orange-500"></span>
            <p class="text-sm font-semibold uppercase tracking-[0.18em] text-orange-600">
              Your donation
            </p>
          </div>

          <h2 class="mb-7 text-2xl font-bold text-gray-950 sm:text-3xl">
            Your donation will go towards:
          </h2>

          <div class="grid gap-4 sm:grid-cols-2">

            <div class="flex items-center gap-4 rounded-2xl bg-orange-50/70 p-4">
              <div class="flex size-12 shrink-0 items-center justify-center rounded-full bg-orange-100 text-orange-600">
                <Icon name="tabler:bottle" class="size-6" />
              </div>
              <p class="text-sm font-medium leading-relaxed text-gray-700">
                {entry.data.items[0]}
              </p>
            </div>

            <div class="flex items-center gap-4 rounded-2xl bg-orange-50/70 p-4">
              <div class="flex size-12 shrink-0 items-center justify-center rounded-full bg-orange-100 text-orange-600">
                <Icon name="lucide:person-standing" class="size-6" />
              </div>
              <p class="text-sm font-medium leading-relaxed text-gray-700">
                {entry.data.items[1]}
              </p>
            </div>

            <div class="flex items-center gap-4 rounded-2xl bg-orange-50/70 p-4">
              <div class="flex size-12 shrink-0 items-center justify-center rounded-full bg-orange-100 text-orange-600">
                <Icon name="lucide:shirt" class="size-6" />
              </div>
              <p class="text-sm font-medium leading-relaxed text-gray-700">
                {entry.data.items[2]}
              </p>
            </div>

            <div class="flex items-center gap-4 rounded-2xl bg-orange-50/70 p-4">
              <div class="flex size-12 shrink-0 items-center justify-center rounded-full bg-orange-100 text-orange-600">
                <Icon name="tabler:blender" class="size-6" />
              </div>
              <p class="text-sm font-medium leading-relaxed text-gray-700">
                {entry.data.items[3]}
              </p>
            </div>

          </div>
        </div>

      </div>


      <!-- RIGHT COLUMN: DONATION FORM -->
      <div class="relative min-w-0 lg:pt-2" transition:animate="none">

        <div class="relative rounded-3xl bg-orange-50/70 p-6 sm:p-8 lg:p-9">

          <!-- DECORATIVE HEART -->
          <div class="absolute right-6 top-6 text-orange-600 sm:right-8 sm:top-8">
            <Icon name="tabler:heart" class="size-6" />
          </div>

          <div class="mb-6 pr-12">

            <div class="mb-4 flex items-center gap-3">
              <span class="h-px w-10 bg-orange-500"></span>
              <span class="text-xs font-semibold uppercase tracking-[0.18em] text-orange-600">
                Make a difference
              </span>
            </div>

            <h2 class="text-3xl font-bold leading-tight tracking-tight text-gray-950 sm:text-4xl">
              Every little bit helps.
            </h2>

            <p class="mt-3 text-base leading-relaxed text-gray-500">
              Your support helps us continue our work in the community.
            </p>

          </div>

          <!-- DONORBOX: ORIGINAL DONATION FORM -->
          <div class="overflow-hidden rounded-2xl bg-white p-2 sm:p-4">

            <iframe
              title="Donorbox"
              name="donorbox"
              src="https://donorbox.org/embed/vulnerable-support-charitable-trust"
              loading="lazy"
              class="mx-auto block h-[620px] w-full max-w-[400px] rounded-xl sm:h-[612px]"
            ></iframe>

          </div>

          <div class="mx-auto mt-6 max-w-prose text-sm leading-relaxed text-gray-600">
            <Content />
          </div>

        </div>

      </div>

    </section>

  </main>
</Layout>