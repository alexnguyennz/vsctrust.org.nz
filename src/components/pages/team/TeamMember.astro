---
import { getEntry, render, type CollectionEntry } from "astro:content";
import { Image } from "astro:assets";

interface Props {
  trust: CollectionEntry<"team"> | CollectionEntry<"trust">;
  category: "team" | "trust";
}

const { trust, category } = Astro.props;

const entry = await getEntry(category, trust.id);
if (!entry) throw new Error("Could not find team member");

const { Content } = await render(entry);
---

<div class="flex flex-col gap-6 border-b border-stone-100 py-10 last:border-b-0 md:flex-row md:gap-10">

  <div class="flex flex-shrink-0 justify-center md:justify-start">
    <Image
      src={trust.data.image}
      width="128"
      height="128"
      alt={`${trust.data.name} profile image`}
      class="size-32 rounded-full object-cover"
    />
  </div>

  <div class="text-center md:text-left">
    <h2 class="m-0 text-lg font-semibold">
      {trust.data.name}

      {
        trust.id === "leigh-keown" && (
          <a href="mailto:hello@vsctrust.org.nz" class="ml-1 text-orange-500">
            ✉
          </a>
        )
      }
    </h2>
    <h3 class="mb-4 text-sm font-medium uppercase tracking-wide text-orange-500">
      {trust.data.position}
    </h3>

    <div class="max-w-2xl text-sm leading-relaxed text-stone-600">
      <Content />
    </div>
  </div>

</div>