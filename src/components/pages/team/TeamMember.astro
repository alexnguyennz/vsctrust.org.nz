---
import { getEntry, render, type CollectionEntry } from "astro:content";
import { Image } from "astro:assets";

interface Props {
  trust: CollectionEntry<"team"> | CollectionEntry<"trust">;
  category: "team" | "trust";
}

const { trust, category } = Astro.props;

const entry = await getEntry(category, trust.id);
if (!entry) throw new Error("Could not find team member");

const { Content } = await render(entry);
---

<div class="flex flex-col items-center px-4 py-8 text-center">

  <Image
    src={trust.data.image}
    width="128"
    height="128"
    alt={`${trust.data.name} profile image`}
    class="size-32 rounded-full object-cover"
  />

  <div class="mt-5">
    <h2 class="m-0 text-lg font-semibold">
      {trust.data.name}

      {
        trust.id === "leigh-keown" && (
          <a href="mailto:hello@vsctrust.org.nz" class="ml-1 text-orange-500">
            ✉
          </a>
        )
      }
    </h2>
    <h3 class="mb-0 text-sm font-medium uppercase tracking-wide text-orange-500">
      {trust.data.position}
    </h3>
  </div>

  <div class="mx-auto mt-4 h-px w-10 bg-stone-200"></div>

  <div class="mt-4 text-sm leading-relaxed text-stone-600">
    <Content />
  </div>

</div>