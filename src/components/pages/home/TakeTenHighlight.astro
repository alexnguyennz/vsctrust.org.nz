---
// Homepage highlight: "A night at Take 10" with the 3 most impactful photos.
const photos = [
  {
    src: "/img/take10/help-time-out.jpg",
    alt: "A Take 10 volunteer comforting someone who is upset",
    label: "Time out",
    position: "center",
  },
  {
    src: "/img/take10/help-unwell.jpg",
    alt: "A Take 10 volunteer sitting with someone who feels unwell",
    label: "Feeling unwell",
    position: "center top",
  },
  {
    src: "/img/take10/help-first-aid.jpg",
    alt: "Gloved hands applying a plaster to someone's finger",
    label: "First aid",
    position: "center",
  },
];
---

<section class="t10h">
  <div class="t10h-inner">

    <div class="t10h-heading">
      <div>
        <p class="t10h-label">Take 10</p>
        <h2 class="t10h-title">A night at Take 10</h2>
      </div>
      <div class="t10h-side">
        <p class="t10h-text">
          Every Friday and Saturday night, our trained volunteers offer a safe
          place to pause, water, first aid and a friendly face, with no judgement.
        </p>
        <a href="/take10/#how-we-help" class="t10h-button">
          See how we help <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>

    <div class="t10h-grid">
      {photos.map((photo) => (
        <a href="/take10/#how-we-help" class="t10h-card">
          <img
            src={photo.src}
            alt={photo.alt}
            loading="lazy"
            style={`object-position: ${photo.position};`}
          />
          <span class="t10h-tag">{photo.label}</span>
        </a>
      ))}
    </div>

    <p class="t10h-note">Scenes recreated by our Take 10 team.</p>

  </div>
</section>

<style>
  .t10h {
    padding: 80px 20px 40px;
  }

  .t10h-inner {
    max-width: 1250px;
    margin: 0 auto;
  }

  .t10h-heading {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    align-items: end;
    margin-bottom: 40px;
  }

  .t10h-label {
    margin: 0 0 12px;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #f97316;
  }

  .t10h-title {
    margin: 0;
    font-size: clamp(2.2rem, 4vw, 3.4rem);
    font-weight: 700;
    line-height: 1.05;
    color: #111827;
  }

  .t10h-text {
    margin: 0 0 22px;
    font-size: 1.05rem;
    line-height: 1.7;
    color: #4b5563;
  }

  .t10h-button {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 13px 26px;
    border-radius: 999px;
    background: #f97316;
    color: #fff;
    font-weight: 600;
    text-decoration: none;
    transition: background 0.2s ease;
  }

  .t10h-button:hover {
    background: #ea580c;
  }

  .t10h-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr;
    gap: 20px;
  }

  .t10h-card {
    position: relative;
    display: block;
    height: 440px;
    border-radius: 22px;
    overflow: hidden;
  }

  .t10h-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s ease;
  }

  .t10h-card:hover img {
    transform: scale(1.05);
  }

  .t10h-card::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.45), transparent 45%);
    pointer-events: none;
  }

  .t10h-tag {
    position: absolute;
    left: 20px;
    bottom: 20px;
    z-index: 1;
    padding: 8px 16px;
    border-radius: 999px;
    background: #fff;
    color: #111827;
    font-size: 0.9rem;
    font-weight: 600;
  }

  .t10h-note {
    margin: 18px 0 0;
    text-align: center;
    font-size: 0.8rem;
    font-style: italic;
    color: #9ca3af;
  }

  @media (max-width: 800px) {
    .t10h {
      padding: 60px 16px 30px;
    }

    .t10h-heading {
      grid-template-columns: 1fr;
      gap: 18px;
    }

    .t10h-grid {
      grid-template-columns: 1fr 1fr;
    }

    .t10h-card {
      height: 260px;
    }

    .t10h-card:first-child {
      grid-column: 1 / -1;
      height: 300px;
    }
  }
</style>