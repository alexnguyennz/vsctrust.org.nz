---
import { cn } from "@/lib/utils";

const { class: className, ...rest } = Astro.props;
---

<button
  class={cn(
    "border border-black/50 relative inline-block rounded-md px-4 py-2 font-semibold tracking-wide text-white no-underline transition-all hover:no-underline",
    className,
  )}
  {...rest}><slot />
</button>