$$---
import { Image } from "astro:assets";
import { Navigation } from "./Navigation";
import { MobileSheet } from "./MobileSheet";
import logo from "@/assets/img/logo/vsct-logo-new.png";
const pathname = new URL(Astro.request.url).pathname;
const isTake10 = pathname === "/take10/";
---
<header
  id="site-header"
  class:list={["absolute top-0 left-0 z-30 w-full transition", isTake10 ? "site-header--light bg-white/10" : "bg-transparent"]}
  transition:animate="none"
>
  <div
    class="mx-auto flex items-center justify-between gap-4 px-5 py-2 lg:container lg:max-w-7xl"
  >
    <!-- LOGO -->
    <a href="/" aria-label="Home page" rel="prefetch" class="shrink-0">
      <Image
        src={logo}
        width="370"
        height="70"
        alt="Vulnerable Support Charitable Trust logo"
        class="header-logo h-auto w-[220px] sm:w-[260px] lg:w-[245px] xl:w-[270px] 2xl:w-[330px]"
        fetchpriority="high"
        loading="eager"
      />
    </a>

    <!-- DESKTOP NAVIGATION -->
    <div class="hidden min-w-0 lg:block">
      <Navigation pathname={pathname} client:visible />
    </div>

    <!-- MOBILE / TABLETTE : bouton don toujours visible + menu -->
    <div class="flex items-center gap-3 lg:hidden">
      <a
        href="/support-us/"
        class="header-donate-mobile rounded-full px-5 py-2.5 text-sm font-bold uppercase tracking-wide no-underline"
      >
        Donate
      </a>
      <MobileSheet client:visible />
    </div>
  </div>
</header>
<style is:global>
  #site-header {
    background: transparent !important;
  }
  #site-header .header-logo {
    filter: brightness(0);
  }
  #site-header nav a,
  #site-header nav button {
    color: #171717 !important;
  }
  #site-header nav a:hover,
  #site-header nav button:hover {
    color: #171717 !important;
  }
  /* BOUTON VOLUNTEER — orange, texte blanc */
  #site-header nav a.site-header-cta[href="/volunteer/"] {
    background-color: #f47b20 !important;
    color: #ffffff !important;
  }
  #site-header nav a.site-header-cta[href="/volunteer/"]:hover {
    background-color: #f47b20 !important;
    color: #ffffff !important;
  }
  /* BOUTON DONATION — noir, texte blanc */
  #site-header nav a.site-header-cta[href="/support-us/"] {
    background-color: #171717 !important;
    color: #ffffff !important;
  }
  #site-header nav a.site-header-cta[href="/support-us/"]:hover {
    background-color: #171717 !important;
    color: #ffffff !important;
  }

  /* BOUTON DONATE sur mobile / tablette */
  #site-header .header-donate-mobile {
    background-color: #171717;
    color: #ffffff !important;
  }
  #site-header .header-donate-mobile:hover {
    background-color: #f47b20;
  }

  /* ========================================
     PETITS PORTABLES (1024px à 1279px)
     Menu compact pour que les deux ronds
     tiennent toujours à l'écran
     ======================================== */
  @media (min-width: 1024px) and (max-width: 1279px) {
    #site-header nav a:not(.site-header-cta),
    #site-header nav button {
      font-size: 16px !important;
      padding-left: 10px !important;
      padding-right: 10px !important;
    }
    #site-header nav a.site-header-cta {
      width: 80px !important;
      height: 80px !important;
      min-width: 80px !important;
      font-size: 11.5px !important;
      line-height: 1.15 !important;
    }
  }

  /* ========================================
     PORTABLES MOYENS (1280px à 1535px)
     ======================================== */
  @media (min-width: 1280px) and (max-width: 1535px) {
    #site-header nav a:not(.site-header-cta),
    #site-header nav button {
      font-size: 15px !important;
    }
    #site-header nav a.site-header-cta {
      width: 78px !important;
      height: 78px !important;
      min-width: 78px !important;
      font-size: 11px !important;
      line-height: 1.15 !important;
    }
  }

  @media (max-width: 1023px) {
    #site-header {
      background: transparent !important;
    }
    #site-header .header-logo {
      filter: brightness(0);
    }
  }

  /* ========================================
     TAKE 10 PAGE ONLY — light header
     ======================================== */
  #site-header.site-header--light {
    background: rgba(255, 255, 255, 0.12) !important;
    backdrop-filter: blur(2px);
  }
  #site-header.site-header--light .header-logo {
    filter: brightness(0) invert(1);
  }
  #site-header.site-header--light nav a,
  #site-header.site-header--light nav button {
    color: #ffffff !important;
  }
  #site-header.site-header--light nav a:hover,
  #site-header.site-header--light nav button:hover {
    color: #ffffff !important;
  }
  #site-header.site-header--light nav a.site-header-cta[href="/volunteer/"] {
    background-color: #f47b20 !important;
    color: #ffffff !important;
  }
  #site-header.site-header--light nav a.site-header-cta[href="/support-us/"] {
    background-color: #171717 !important;
    color: #ffffff !important;
  }
  @media (max-width: 1023px) {
    #site-header.site-header--light {
      background: rgba(255, 255, 255, 0.12) !important;
    }
    #site-header.site-header--light .header-logo {
      filter: brightness(0) invert(1);
    }
  }

  /* ========================================
     DROPDOWN PANEL — always dark text,
     even when the header itself is light,
     because the panel background is white.
     ======================================== */
  #site-header .dropdown-panel a,
  #site-header .dropdown-panel a * {
    color: #171717 !important;
  }
  #site-header.site-header--light .dropdown-panel a,
  #site-header.site-header--light .dropdown-panel a * {
    color: #171717 !important;
  }
</style>