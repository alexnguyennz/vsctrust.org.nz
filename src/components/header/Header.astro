---
import { Image } from "astro:assets";
import { Navigation } from "./Navigation";
import { MobileSheet } from "./MobileSheet";
const pathname = new URL(Astro.request.url).pathname;
---

<header
  id="site-header"
  class="absolute top-0 left-0 z-20 w-full bg-transparent transition"
  transition:animate="none"
>
  <div class="mx-auto my-1 flex items-center justify-between gap-6 px-5 lg:container lg:max-w-7xl">

    <a href="/" aria-label="home page" rel="prefetch"><Image src={import("@/assets/img/logo/vsct-logo-new.png")} width="370" height="70" alt="Vulnerable Support Charitable Trust logo" class="h-auto" fetchpriority="high" loading="eager" /></a>

    <div class="hidden lg:block">
      <Navigation pathname={pathname} client:visible />
    </div>

    <div class="lg:hidden">
      <MobileSheet client:visible />
    </div>
  </div>

  <div class="absolute right-6 top-full hidden -translate-y-1/3 gap-4 lg:flex z-30">
    <a href="/volunteer/" class="flex h-24 w-24 flex-col items-center justify-center rounded-full bg-orange-500 text-center text-xs font-bold uppercase leading-tight text-white shadow-lg transition hover:scale-105">
      Become a<br />Volunteer
    </a>
    <a href="/support-us/" class="flex h-24 w-24 flex-col items-center justify-center rounded-full bg-stone-900 text-center text-xs font-bold uppercase leading-tight text-white shadow-lg transition hover:scale-105">
      Make a<br />Donation
    </a>
  </div>
</header>

<script>
  function applyHeader() {
    const header = document.getElementById("site-header");

    window.addEventListener("scroll", () => {

    });
  }

  document.addEventListener("astro:after-swap", applyHeader);
  applyHeader();
</script>