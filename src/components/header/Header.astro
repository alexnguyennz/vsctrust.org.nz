---
import { Image } from "astro:assets";
import { Navigation } from "./Navigation";
import { MobileSheet } from "./MobileSheet";
import logo from "@/assets/img/logo/vsct-logo-new.png";
const pathname = new URL(Astro.request.url).pathname;
const isTake10 = pathname === "/take10/";
---
<header
  id="site-header"
  class:list={["absolute top-0 left-0 z-20 w-full transition", isTake10 ? "site-header--light bg-white/10" : "bg-transparent"]}
  transition:animate="none"
>
  <div
    class="mx-auto flex items-center justify-between gap-6 px-5 py-2 lg:container lg:max-w-7xl"
  >
    <!-- LOGO -->
    <a href="/" aria-label="Home page" rel="prefetch" class="shrink-0">
      <Image
        src={logo}
        width="370"
        height="70"
        alt="Vulnerable Support Charitable Trust logo"
        class="header-logo h-auto"
        fetchpriority="high"
        loading="eager"
      />
    </a>
    <!-- DESKTOP NAVIGATION -->
    <div class="hidden lg:block">
      <Navigation pathname={pathname} client:visible />
    </div>
    <!-- MOBILE MENU -->
    <div class="lg:hidden">
      <MobileSheet client:visible />
    </div>
  </div>
</header>
<style is:global>
  #site-header {
    background: transparent !important;
  }
  #site-header .header-logo {
    filter: brightness(0);
  }
  #site-header nav a,
  #site-header nav button {
    color: #171717 !important;
  }
  #site-header nav a:hover,
  #site-header nav button:hover {
    color: #171717 !important;
  }
  /* BOUTON VOLUNTEER — orange, texte blanc */
  #site-header nav a[href="/volunteer/"] {
    background-color: #f47b20 !important;
    color: #ffffff !important;
  }
  #site-header nav a[href="/volunteer/"]:hover {
    background-color: #f47b20 !important;
    color: #ffffff !important;
  }
  /* BOUTON DONATION — noir, texte blanc */
  #site-header nav a[href="/support-us/"] {
    background-color: #171717 !important;
    color: #ffffff !important;
  }
  #site-header nav a[href="/support-us/"]:hover {
    background-color: #171717 !important;
    color: #ffffff !important;
  }
  @media (max-width: 1023px) {
    #site-header {
      background: transparent !important;
    }
    #site-header .header-logo {
      filter: brightness(0);
    }
  }

  /* ========================================
     TAKE 10 PAGE ONLY — light header
     ======================================== */
  #site-header.site-header--light {
    background: rgba(255, 255, 255, 0.12) !important;
    backdrop-filter: blur(2px);
  }
  #site-header.site-header--light .header-logo {
    filter: brightness(0) invert(1);
  }
  #site-header.site-header--light nav a,
  #site-header.site-header--light nav button {
    color: #ffffff !important;
  }
  #site-header.site-header--light nav a:hover,
  #site-header.site-header--light nav button:hover {
    color: #ffffff !important;
  }
  #site-header.site-header--light nav a[href="/volunteer/"] {
    background-color: #f47b20 !important;
    color: #ffffff !important;
  }
  #site-header.site-header--light nav a[href="/support-us/"] {
    background-color: #171717 !important;
    color: #ffffff !important;
  }
  @media (max-width: 1023px) {
    #site-header.site-header--light {
      background: rgba(255, 255, 255, 0.12) !important;
    }
    #site-header.site-header--light .header-logo {
      filter: brightness(0) invert(1);
    }
  }
</style>