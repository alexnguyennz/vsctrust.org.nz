---
import { Image } from "astro:assets";
import { Navigation } from "./Navigation";
import MobileSheet from "./MobileSheet";

const pathname = new URL(Astro.request.url).pathname;
---

<header
  id="site-header"
  class="absolute top-0 left-0 z-50 w-full bg-white"
>
  <div
    class="mx-auto flex min-h-[100px] items-center justify-between gap-6 px-6 lg:container lg:max-w-7xl"
  >

    <!-- LOGO -->
    <a
      href="/"
      aria-label="Home page"
      rel="prefetch"
      class="shrink-0"
    >
      <Image
        src={import("@/assets/img/logo-new.png")}
        width="370"
        height="70"
        alt="Vulnerable Support Charitable Trust logo"
        class="h-auto w-[250px] lg:w-[310px]"
        fetchpriority="high"
        loading="eager"
      />
    </a>

    <!-- DESKTOP NAVIGATION -->
    <div class="hidden lg:flex items-center">
      <Navigation pathname={pathname} client:visible />
    </div>

    <!-- ACTION BUTTONS -->
    <div class="hidden lg:flex items-center gap-3">

      <a
        href="/volunteer/"
        class="inline-flex items-center justify-center rounded-xl bg-orange-500 px-5 py-4 text-sm font-bold text-white transition hover:bg-orange-600"
      >
        BECOME A VOLUNTEER
      </a>

      <a
        href="/donate/"
        class="inline-flex items-center justify-center rounded-xl bg-black px-5 py-4 text-sm font-bold text-white transition hover:bg-gray-800"
      >
        MAKE A DONATION
      </a>

    </div>

    <!-- MOBILE MENU -->
    <div class="lg:hidden">
      <MobileSheet client:visible />
    </div>

  </div>
</header>