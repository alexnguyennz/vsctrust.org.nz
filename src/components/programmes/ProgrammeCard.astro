---
import { Image, getImage } from "astro:assets";

const images = import.meta.glob("../../assets/img/programmes/*");

const name = {
  dosomegood: "Do Some Good",
  take10: "Take 10",
  "take10-auckland": "Take 10 Auckland",
  "take10-arvos": "Take 10 Arvo's",
};

interface Props {
  programme: "dosomegood" | "take10" | "take10-auckland";
}

const { programme } = Astro.props;

// Generate card background images
const background = await getImage({
  src: images[
    `../../assets/img/programmes/${programme}.jpg`
  ]() as unknown as string,
  format: "webp",
  width: 600,
});

const backgroundHover = await getImage({
  src: images[
    `../../assets/img/programmes/${programme}-hover.jpg`
  ]() as unknown as string,
  format: "webp",
  width: 600,
});
---

<details class="programme-card">
  <summary class="cursor-pointer list-none">
    <div class="programme relative h-[240px] overflow-hidden rounded-3xl shadow-lg">
      
      <Image
        src={background}
        width={600}
        alt={`${name[programme]} background`}
        class="absolute inset-0 h-full w-full object-cover"
      />

      <div class="absolute inset-0 bg-black/20"></div>

      <Image
        src={import(`../../assets/img/logo/${programme}.png`)}
        width={150}
        height={150}
        alt={`${name[programme]} logo`}
        class="absolute left-1/2 top-1/2 z-10 size-32 -translate-x-1/2 -translate-y-1/2 object-contain"
      />

      <div class="absolute bottom-0 left-0 right-0 z-10 bg-black/65 px-5 py-4">
        <h3 class="text-xl font-bold text-white">
          {name[programme]}
        </h3>
      </div>

    </div>
  </summary>

  <div class="mt-4 rounded-3xl bg-white p-6 shadow-lg">
    <div class="text-gray-800">
      <slot />
    </div>

    <a
      href={`/${programme}/`}
      class="mt-5 inline-block font-semibold text-[#f5a623] hover:underline"
    >
      View programme →
    </a>
  </div>
</details>
<style>
  .programme-card summary::-webkit-details-marker {
    display: none;
  }

  .programme-card summary {
    list-style: none;
  }

  .programme-card summary::-webkit-details-marker {
    display: none;
  }
</style>
